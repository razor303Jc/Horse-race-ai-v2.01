FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (fix Playwright issues)
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    libglib2.0-0 \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libxss1 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python packages
COPY docker/requirements/requirements-auto-downloader.txt .
RUN pip install --no-cache-dir -r requirements-auto-downloader.txt

# Install Playwright browsers (ensure they are installed properly)
# First install system dependencies manually to avoid font package issues
RUN apt-get update && apt-get install -y \
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-noto-cjk \
    libcups2 \
    libxkbcommon0 \
    libxfixes3 \
    libcairo2 \
    libpango-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright browsers and ensure they download properly
RUN PLAYWRIGHT_BROWSERS_PATH=/app/.playwright playwright install chromium
RUN PLAYWRIGHT_BROWSERS_PATH=/app/.playwright playwright install-deps chromium || true
# Set environment variable for runtime
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright
# Verify Playwright installation works
RUN python -c "import os; os.environ['PLAYWRIGHT_BROWSERS_PATH']='/app/.playwright'; from playwright.sync_api import sync_playwright; p = sync_playwright().start(); print('Playwright installed successfully'); p.stop()"

# Copy application code
COPY src/ ./src/
COPY run_docker_auto_downloader.py .
COPY working_auto_downloader.py .
COPY data_validator.py .
COPY config/ ./config/

# Create directories
RUN mkdir -p data logs cache

# Create user
ARG USER_NAME=jc
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} ${USER_NAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/bash ${USER_NAME} && \
    chown -R ${USER_NAME}:${USER_NAME} /app
USER ${USER_NAME}

CMD ["python", "run_docker_auto_downloader.py", "--mode", "scheduled"]
