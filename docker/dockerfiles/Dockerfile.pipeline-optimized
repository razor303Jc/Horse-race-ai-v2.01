# Optimized Dockerfile for Pipeline Management Service
# Build time: ~3 minutes (vs 15+ minutes with full requirements)

FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies (minimal)
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy optimized requirements
COPY docker/requirements/requirements-pipeline-management-optimized.txt .

# Install Python dependencies (only what's needed)
RUN pip install --no-cache-dir -r requirements-pipeline-management-optimized.txt

# Copy pipeline management code
COPY docker/pipeline_management/ ./pipeline_management/
COPY tools/ ./tools/
COPY config/ ./config/

# Create required directories with proper permissions
RUN mkdir -p logs data data/daily_downloads cache && \
    chmod 755 logs data data/daily_downloads cache

# Create non-root user for security using environment variable
ARG USER_NAME=jc
ARG USER_ID=1000
ARG GROUP_ID=1000

RUN groupadd -g ${GROUP_ID} ${USER_NAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/bash ${USER_NAME} && \
    chown -R ${USER_NAME}:${USER_NAME} /app && \
    chmod -R 755 /app/logs /app/data /app/cache

USER ${USER_NAME}

# Set Python path
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import pipeline_management.dynamic_pipeline_timing; print('OK')" || exit 1

# Default command
CMD ["python", "tools/pipeline_coordinator.py"]
