# Optimized Dockerfile for Data Processing Service
# Build time: ~4 minutes (vs 15+ minutes with full requirements)

FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy optimized requirements
COPY docker/requirements/requirements-data-processing-optimized.txt .

# Install Python dependencies (optimized set)
RUN pip install --no-cache-dir -r requirements-data-processing-optimized.txt

# Copy data processing code
COPY docker/data_processing/ ./data_processing/
COPY config/ ./config/

# Create necessary directories
RUN mkdir -p data/daily_downloads logs cache && \
    chmod 777 data/daily_downloads logs cache

# Set Python path
ENV PYTHONPATH=/app:/app/data_processing

# Create non-root user for security using environment variable
ARG USER_NAME=jc
ARG USER_ID=1000
ARG GROUP_ID=1000

RUN groupadd -g ${GROUP_ID} ${USER_NAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/bash ${USER_NAME} && \
    chown -R ${USER_NAME}:${USER_NAME} /app
USER ${USER_NAME}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import data_processing.complete_csv_processor; print('OK')" || exit 1

# Default command
CMD ["python", "data_processing/complete_csv_processor.py"]
