# Custom MkDocs with Python reporting capabilities
FROM squidfunk/mkdocs-material:latest

# Install system dependencies and Python packages as root
USER root
RUN apk add --no-cache \
    gcc \
    g++ \
    musl-dev \
    linux-headers \
    postgresql-dev \
    python3-dev \
    build-base \
    libffi-dev \
    openssl-dev

# Install Python packages for data analysis and visualization
RUN pip install --no-cache-dir \
    pandas \
    numpy \
    matplotlib \
    seaborn \
    plotly \
    kaleido \
    psycopg2-binary \
    scikit-learn \
    joblib \
    psutil \
    python-dotenv

# Install MkDocs plugins that exist
RUN pip install --no-cache-dir \
    mkdocs-jupyter \
    mkdocs-table-reader-plugin \
    mkdocs-macros-plugin

# Clean up build dependencies to reduce image size
RUN apk del gcc g++ musl-dev linux-headers python3-dev build-base

# Create reports directory
RUN mkdir -p /docs/reports

# Set working directory
WORKDIR /docs

# Default command
CMD ["serve", "--dev-addr=0.0.0.0:8000"]
