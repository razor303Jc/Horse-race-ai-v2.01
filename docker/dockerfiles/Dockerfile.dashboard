# Production Dashboard Dockerfile
# Specialized container for web dashboard deployment

FROM python:3.11-slim

# Set arguments for user creation
ARG USER_NAME=jc
ARG USER_ID=1000
ARG GROUP_ID=1000

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    nginx \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Create user and group
RUN groupadd -g $GROUP_ID $USER_NAME && \
    useradd -r -u $USER_ID -g $GROUP_ID -s /bin/bash -m $USER_NAME

# Set working directory
WORKDIR /app

# Copy requirements first for better Docker layer caching
COPY api/requirements.txt /app/api/requirements.txt
COPY docker/requirements-integrated.txt /app/docker/requirements-integrated.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r /app/api/requirements.txt && \
    pip install --no-cache-dir -r /app/docker/requirements-integrated.txt && \
    pip install --no-cache-dir \
    gunicorn \
    flask-cors \
    flask-socketio

# Copy application code
COPY src/ /app/src/
COPY templates/ /app/templates/
COPY config/ /app/config/

# Copy nginx configuration
COPY docker/nginx/dashboard.conf /etc/nginx/sites-available/default

# Set proper permissions
RUN chown -R $USER_NAME:$USER_NAME /app

# Switch to non-root user
USER $USER_NAME

# Create necessary directories
RUN mkdir -p /app/logs

# Environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV FLASK_APP=src.horse_racing_ai.deployment.production_dashboard
ENV FLASK_ENV=production

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Default command - runs Gunicorn with Flask app
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "4", "--timeout", "120", "src.horse_racing_ai.deployment.production_dashboard:app"]
