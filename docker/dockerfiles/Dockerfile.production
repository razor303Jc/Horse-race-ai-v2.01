# Production Trading Dockerfile
# Specialized container for live strategy execution and trading automation

FROM python:3.11-slim

# Set arguments for user creation
ARG USER_NAME=jc
ARG USER_ID=1000
ARG GROUP_ID=1000

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create user and group
RUN groupadd -g $GROUP_ID $USER_NAME && \
    useradd -r -u $USER_ID -g $GROUP_ID -s /bin/bash -m $USER_NAME

# Set working directory
WORKDIR /app

# Copy requirements first for better Docker layer caching
COPY api/requirements.txt /app/api/requirements.txt
COPY docker/requirements-integrated.txt /app/docker/requirements-integrated.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r /app/api/requirements.txt && \
    pip install --no-cache-dir -r /app/docker/requirements-integrated.txt && \
    pip install --no-cache-dir \
    betfairlightweight \
    websockets \
    asyncio \
    aiohttp \
    schedule

# Copy application code
COPY src/ /app/src/
COPY config/ /app/config/
COPY models/ /app/models/
COPY templates/ /app/templates/

# Set proper permissions
RUN chown -R $USER_NAME:$USER_NAME /app

# Switch to non-root user
USER $USER_NAME

# Create necessary directories
RUN mkdir -p /app/logs /app/data

# Environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Default command - runs live strategy execution
CMD ["python", "-m", "src.horse_racing_ai.production.live_strategy_execution"]
