# Custom Node-RED Docker Image for Horse Racing AI
FROM nodered/node-red:latest

USER root

# Install additional system dependencies if needed
RUN apk add --no-cache \
    python3 \
    py3-pip \
    curl \
    git \
    docker-cli

# Get host Docker group ID and create docker group with same GID
ARG DOCKER_GID=999
RUN addgroup -g ${DOCKER_GID} docker 2>/dev/null || true
RUN adduser node-red docker 2>/dev/null || true

# Copy minimal package.json first to test
COPY --chown=node-red:node-red package-minimal.json /usr/src/node-red/package.json

# Change to working directory and install minimal dependencies
WORKDIR /usr/src/node-red
RUN npm install

# Copy Node-RED flows and configuration
COPY --chown=node-red:node-red flows-enhanced-c2.json /data/flows.json
COPY --chown=node-red:node-red settings.js /data/settings.js

# Switch back to node-red user
USER node-red

# Use Node-RED default entrypoint
CMD ["npm", "start"]
