        "type": "function",
        "z": "c2-dashboard-flow",
        "name": "Health Status",
        "func": "msg.payload = {\n    status: 'healthy',\n    timestamp: new Date().toISOString(),\n    services: {\n        'node-red': 'online',\n        'database': 'online',\n        'web-app': 'online'\n    }\n};\nreturn msg;",
        "outputs": 1,
        "x": 320,
        "y": 160,
        "wires": [["health-http-response"]]
    },
    {
        "id": "health-http-response",
