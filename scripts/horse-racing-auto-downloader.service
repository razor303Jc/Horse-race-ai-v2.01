[Unit]
Description=Horse Racing AI - Respectful Auto Downloader Scheduler
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=jc
Group=jc
WorkingDirectory=/home/jc/Documents/Horse-race-ai-v2.01
Environment=PYTHONPATH=/home/jc/Documents/Horse-race-ai-v2.01/src
ExecStart=/usr/bin/python3 /home/jc/Documents/Horse-race-ai-v2.01/src/automation/daily_scheduler.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=horse-racing-auto-downloader

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/jc/Documents/Horse-race-ai-v2.01/data
ReadWritePaths=/home/jc/Documents/Horse-race-ai-v2.01/logs

[Install]
WantedBy=multi-user.target
