[Unit]
Description=Horse Racing Auto Downloader Service
Documentation=https://github.com/jc/Horse-race-ai-v2.01
After=docker.service
Requires=docker.service
StartLimitInterval=60s
StartLimitBurst=3

[Service]
Type=forking
User=jc
Group=jc
WorkingDirectory=/home/jc/Documents/Horse-race-ai-v2.01

# Service management script
ExecStart=/home/jc/Documents/Horse-race-ai-v2.01/scripts/auto-downloader-service.sh start
ExecStop=/home/jc/Documents/Horse-race-ai-v2.01/scripts/auto-downloader-service.sh stop
ExecReload=/home/jc/Documents/Horse-race-ai-v2.01/scripts/auto-downloader-service.sh restart

# Health monitoring
ExecStartPost=/bin/sleep 10
ExecStartPost=/home/jc/Documents/Horse-race-ai-v2.01/scripts/auto-downloader-service.sh status

# Restart configuration
Restart=always
RestartSec=30s
TimeoutStartSec=120s
TimeoutStopSec=30s

# Environment
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DOCKER_COMPOSE_FILE=/home/jc/Documents/Horse-race-ai-v2.01/docker-compose.auto-downloader.yml

# Security
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=false
ProtectHome=false

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=horserace-auto-downloader

[Install]
WantedBy=multi-user.target
Alias=auto-downloader.service
