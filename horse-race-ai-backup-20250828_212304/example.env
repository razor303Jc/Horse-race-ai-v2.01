# Environment Configuration for Horse Racing AI
# User and Permission Settings
USER_NAME=your_name
USER_ID=1000
GROUP_ID=1000

# Database Configuration
POSTGRES_PASSWORD=secure_password_123
REDIS_PASSWORD=redis_password_123

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Notification Settings
NTFY_TOPIC=horse-racing-alerts

# API Keys (Set these if you have them)
BETDAQ_API_KEY=
BETDAQ_USERNAME=
BETDAQ_PASSWORD=
RACING_POST_API_KEY=
TIMEFORM_API_KEY=

# ML Training Settings
ML_TRAINING_ENABLED=true
EARLY_MORNING_TRAINING=true
TRAINING_START_TIME=00:30
TRAINING_END_TIME=04:00


# Data Processing Settings
DATA_PROCESSING_THREADS=4
CACHE_ENABLED=true

# Web Application Settings
WEB_PORT=8000
API_PORT=8001

# Docker Compose Settings
COMPOSE_PROJECT_NAME=horse-racing-ai

DATABASE_URL=postgresql://horse_racing:secure_password_123@postgres:5432/horse_racing_db
# Horse Race Database Credentials
 HORSERACE_DB_USERNAME="your_email_address"
 HORSERACE_DB_PASSWORD="your_password"

