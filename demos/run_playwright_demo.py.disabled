#!/usr/bin/env python3
"""
Quick runner for the Playwright Auto-Download Demo
==================================================

Simple script to execute the comprehensive demonstration.
"""

import asyncio
import sys
from pathlib import Path

# Add current directory to path
current_dir = Path(__file__).parent
sys.path.insert(0, str(current_dir))

from playwright_auto_download_demo import main  # noqa: E402

if __name__ == "__main__":
    print("🏇 Starting Playwright Auto-Download Demo...")
    print("Press Ctrl+C to cancel at any time")
    print("-" * 50)

    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n🛑 Demo cancelled by user")
    except Exception as e:
        print(f"\n❌ Demo failed: {e}")
        sys.exit(1)
