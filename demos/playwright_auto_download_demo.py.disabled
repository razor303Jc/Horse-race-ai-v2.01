#!/usr/bin/env python3
"""
Complete Playwright Auto-Download Demo
======================================

Demonstration of the complete real data collection and integration pipeline:
1. Playwright automated data collection from racing websites
2. Data validation and quality checking
3. Gradual integration with existing synthetic data
4. Integration with training systems
"""

import asyncio
import json
import logging
import time
from datetime import datetime, timedelta
from pathlib import Path
from typing import Any, Dict, List

from rich.console import Console
from rich.layout import Layout
from rich.live import Live
from rich.panel import Panel
from rich.progress import BarColumn, Progress, SpinnerColumn, TextColumn
from rich.table import Table

console = Console()
logger = logging.getLogger(__name__)


class PlaywrightAutoDownloadDemo:
    """Complete demonstration of Playwright auto-download system."""

    def __init__(self):
        """Initialize the demo system."""
        self.console = console
        self.data_dir = Path("data")
        self.demo_dir = self.data_dir / "demo_results"
        self.demo_dir.mkdir(parents=True, exist_ok=True)

        # Demo configuration
        self.demo_config = {
            "collect_real_data": True,
            "validate_data": True,
            "integrate_data": True,
            "test_training_compatibility": True,
            "backup_existing_data": True,
            "simulate_api_fallback": True,
        }

        # Demo statistics
        self.demo_stats = {
            "start_time": None,
            "end_time": None,
            "duration": 0,
            "real_races_collected": 0,
            "data_quality_score": 0.0,
            "integration_success": False,
            "training_compatibility": False,
            "total_operations": 0,
            "successful_operations": 0,
        }

    def create_demo_layout(self) -> Layout:
        """Create the demo dashboard layout."""

        layout = Layout()

        # Split into header and body
        layout.split(
            Layout(name="header", size=3),
            Layout(name="body"),
            Layout(name="footer", size=3),
        )

        # Split body into sections
        layout["body"].split_row(
            Layout(name="status"), Layout(name="progress"), Layout(name="results")
        )

        return layout

    def update_header(self, layout: Layout, status: str):
        """Update the demo header."""

        header_text = f"""
🏇 Playwright Auto-Download System Demo
Status: {status}
Time: {datetime.now().strftime('%H:%M:%S')}
        """.strip()

        layout["header"].update(Panel(header_text, border_style="blue"))

    def update_status(self, layout: Layout, current_step: str, step_details: str):
        """Update the current status panel."""

        status_table = Table(title="Current Operation", show_header=False)
        status_table.add_column("Field", style="cyan", width=20)
        status_table.add_column("Value", style="green")

        status_table.add_row("Step", current_step)
        status_table.add_row("Details", step_details)
        ops_text = (
            f"{self.demo_stats['successful_operations']}/"
            f"{self.demo_stats['total_operations']}"
        )
        status_table.add_row("Operations", ops_text)

        layout["status"].update(Panel(status_table, border_style="green"))

    def update_progress(self, layout: Layout, progress_data: Dict[str, Any]):
        """Update the progress panel."""

        progress_table = Table(title="Demo Progress", show_header=True)
        progress_table.add_column("Component", style="cyan")
        progress_table.add_column("Status", style="yellow")
        progress_table.add_column("Result", style="green")

        components = [
            ("Data Collection", "collect_real_data"),
            ("Data Validation", "validate_data"),
            ("Data Integration", "integrate_data"),
            ("Training Test", "test_training_compatibility"),
            ("Backup Creation", "backup_existing_data"),
            ("API Fallback", "simulate_api_fallback"),
        ]

        for name, key in components:
            if key in progress_data:
                is_complete = progress_data[key]["status"] == "complete"
                status = "✅ Complete" if is_complete else "🔄 Running"
                result = progress_data[key].get("result", "")
            else:
                status = "⏳ Pending"
                result = ""

            progress_table.add_row(name, status, result)

        layout["progress"].update(Panel(progress_table, border_style="yellow"))

    def update_results(self, layout: Layout):
        """Update the results panel."""

        results_table = Table(title="Demo Results", show_header=True)
        results_table.add_column("Metric", style="cyan")
        results_table.add_column("Value", style="green")

        if self.demo_stats["start_time"]:
            elapsed = time.time() - self.demo_stats["start_time"]
            results_table.add_row("Elapsed Time", f"{elapsed:.1f}s")

        results_table.add_row(
            "Real Races", str(self.demo_stats["real_races_collected"])
        )
        quality_text = f"{self.demo_stats['data_quality_score']:.2%}"
        results_table.add_row("Data Quality", quality_text)

        integration_status = "✅" if self.demo_stats["integration_success"] else "❌"
        results_table.add_row("Integration", integration_status)

        training_status = "✅" if self.demo_stats["training_compatibility"] else "❌"
        results_table.add_row("Training Compatible", training_status)

        layout["results"].update(Panel(results_table, border_style="magenta"))

    async def simulate_data_collection(self) -> Dict[str, Any]:
        """Simulate real data collection (since we can't access real sites in demo)."""

        self.console.print("🔍 Simulating Playwright data collection...")

        # Simulate collection delay
        await asyncio.sleep(2)

        # Create simulated real race data
        simulated_races = []

        for i in range(5):  # Simulate collecting 5 races
            race = {
                "race_id": f"DEMO_REAL_{i+1:03d}",
                "track": f"Demo Track {i+1}",
                "race_number": i + 1,
                "race_time": datetime.now().isoformat(),
                "distance": "1200m",
                "surface": "Turf",
                "race_type": "Class 4",
                "conditions": "Good",
                "prize_money": 15000.0,
                "field_size": 8,
                "horses": self._generate_simulated_horses(8),
                "betting_odds": {},
                "source": "simulated_racing_post",
            }

            # Generate betting odds
            for horse in race["horses"]:
                race["betting_odds"][horse["name"]] = horse["odds"]

            simulated_races.append(race)

        # Save simulated data
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        demo_file = self.demo_dir / f"simulated_real_data_{timestamp}.json"

        with open(demo_file, "w") as f:
            json.dump(simulated_races, f, indent=2)

        self.demo_stats["real_races_collected"] = len(simulated_races)

        return {
            "status": "complete",
            "result": f"{len(simulated_races)} races collected",
            "races": simulated_races,
            "file": str(demo_file),
        }

    def _generate_simulated_horses(self, count: int) -> List[Dict[str, Any]]:
        """Generate simulated horse data."""

        horse_names = [
            "Thunder Strike",
            "Lightning Bolt",
            "Storm Chaser",
            "Wind Runner",
            "Fire Flash",
            "Golden Arrow",
            "Silver Bullet",
            "Racing Spirit",
            "Speed Demon",
            "Victory Lane",
            "Champion's Pride",
            "Swift Justice",
        ]

        jockeys = ["J. Smith", "M. Johnson", "A. Williams", "R. Brown", "S. Davis"]
        trainers = ["T. Wilson", "B. Miller", "C. Anderson", "D. Taylor", "E. Moore"]

        horses = []

        for i in range(count):
            horse = {
                "name": horse_names[i % len(horse_names)],
                "age": 4,
                "weight": "9-0",
                "jockey": jockeys[i % len(jockeys)],
                "trainer": trainers[i % len(trainers)],
                "form": "12345",
                "odds": 2.0 + (i * 1.5),
                "recent_runs": self._generate_recent_runs(),
            }
            horses.append(horse)

        return horses

    def _generate_recent_runs(self) -> List[Dict[str, Any]]:
        """Generate simulated recent runs."""

        runs = []

        for i in range(5):
            run = {
                "date": (datetime.now() - timedelta(days=(i + 1) * 14)).strftime(
                    "%Y-%m-%d"
                ),
                "track": "Demo Track",
                "distance": "1200m",
                "surface": "Turf",
                "finish_position": i + 1,
                "field_size": 10,
                "beaten_lengths": i * 0.5,
                "speed_figure": 100 - (i * 5),
                "weight_carried": "9-0",
                "jockey": "Demo Jockey",
                "trainer": "Demo Trainer",
                "odds": 5.0 + i,
                "comments": f"Run {i+1}",
            }
            runs.append(run)

        return runs

    async def simulate_data_validation(
        self, races: List[Dict[str, Any]]
    ) -> Dict[str, Any]:
        """Simulate data validation process."""

        self.console.print("🔍 Validating collected race data...")

        await asyncio.sleep(1)

        # Simulate validation checks
        valid_races = 0
        total_races = len(races)
        issues = []

        for race in races:
            # Check required fields
            if all(
                field in race
                for field in ["race_id", "track", "horses", "betting_odds"]
            ):
                if len(race["horses"]) >= 3:
                    valid_races += 1
                else:
                    issues.append(f"Race {race['race_id']}: Too few horses")
            else:
                issues.append(f"Race {race['race_id']}: Missing required fields")

        quality_score = valid_races / total_races if total_races > 0 else 0
        self.demo_stats["data_quality_score"] = quality_score

        return {
            "status": "complete",
            "result": f"{quality_score:.1%} quality score",
            "quality_score": quality_score,
            "valid_races": valid_races,
            "total_races": total_races,
            "issues": issues,
        }

    async def simulate_data_integration(
        self, races: List[Dict[str, Any]]
    ) -> Dict[str, Any]:
        """Simulate data integration with existing synthetic data."""

        self.console.print("🔄 Integrating real data with synthetic data...")

        await asyncio.sleep(1.5)

        # Check if synthetic data exists
        synthetic_file = self.data_dir / "massive_test_race_cards.json"

        if not synthetic_file.exists():
            return {
                "status": "failed",
                "result": "No synthetic data found",
                "error": "massive_test_race_cards.json not found",
            }

        # Load synthetic data
        with open(synthetic_file, "r") as f:
            synthetic_data = json.load(f)

        # Calculate integration ratio (start with 10% real data)
        total_races = len(synthetic_data)
        real_races_to_include = min(len(races), max(1, total_races // 10))

        # Create backup
        backup_file = (
            self.demo_dir
            / f"synthetic_backup_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        )
        with open(backup_file, "w") as f:
            json.dump(synthetic_data, f, indent=2)

        # Create integrated dataset
        integrated_data = []

        # Add converted real data
        for i in range(real_races_to_include):
            converted_race = self._convert_to_synthetic_format(races[i])
            integrated_data.append(converted_race)

        # Add remaining synthetic data
        synthetic_races_to_include = total_races - real_races_to_include
        integrated_data.extend(synthetic_data[:synthetic_races_to_include])

        # Save integrated data
        integrated_file = (
            self.demo_dir
            / f"integrated_demo_data_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        )
        with open(integrated_file, "w") as f:
            json.dump(integrated_data, f, indent=2)

        self.demo_stats["integration_success"] = True

        real_percentage = (real_races_to_include / total_races) * 100

        return {
            "status": "complete",
            "result": f"{real_percentage:.1f}% real data integrated",
            "real_races": real_races_to_include,
            "synthetic_races": synthetic_races_to_include,
            "total_races": len(integrated_data),
            "backup_file": str(backup_file),
            "integrated_file": str(integrated_file),
        }

    def _convert_to_synthetic_format(self, real_race: Dict[str, Any]) -> Dict[str, Any]:
        """Convert real race to synthetic data format."""

        horses_data = {}
        betting_odds = {}

        for horse in real_race["horses"]:
            horse_name = horse["name"]

            # Convert recent runs
            horse_performances = []
            for run in horse["recent_runs"]:
                perf = {
                    "date": run["date"],
                    "track": run["track"],
                    "distance": run["distance"],
                    "surface": run["surface"],
                    "race_class": "Class 4",
                    "field_size": run["field_size"],
                    "finish_position": run["finish_position"],
                    "beaten_lengths": run["beaten_lengths"],
                    "time": "1:24.56",
                    "speed_figure": run["speed_figure"],
                    "pace_figures": {"early": 85, "late": 90},
                    "weight_carried": run["weight_carried"],
                    "jockey": run["jockey"],
                    "trainer": run["trainer"],
                    "odds": run["odds"],
                    "purse": 15000,
                    "conditions": "Good",
                    "comments": run["comments"],
                }
                horse_performances.append(perf)

            horses_data[horse_name] = horse_performances
            betting_odds[horse_name] = horse["odds"]

        # Create race info
        race_info = {
            "race_id": real_race["race_id"],
            "track": real_race["track"],
            "distance": real_race["distance"],
            "surface": real_race["surface"],
            "race_class": real_race["race_type"],
            "conditions": real_race["conditions"],
            "prize_money": real_race["prize_money"],
            "date": real_race["race_time"][:10],
            "time": "14:30",
        }

        return {
            "race_info": race_info,
            "horses_data": horses_data,
            "betting_odds": betting_odds,
            "source": f"real_data_{real_race['source']}",
        }

    async def test_training_compatibility(self, integrated_file: str) -> Dict[str, Any]:
        """Test if integrated data works with existing training systems."""

        self.console.print("🧪 Testing training system compatibility...")

        await asyncio.sleep(1)

        try:
            # Load integrated data
            with open(integrated_file, "r") as f:
                integrated_data = json.load(f)

            # Test basic data structure compatibility
            test_race = integrated_data[0]

            required_keys = ["race_info", "horses_data", "betting_odds"]

            if all(key in test_race for key in required_keys):
                # Test race_info structure
                race_info = test_race["race_info"]
                race_info_keys = ["race_id", "track", "distance", "surface"]

                if all(key in race_info for key in race_info_keys):
                    # Test horses_data structure
                    horses_data = test_race["horses_data"]

                    if horses_data and isinstance(horses_data, dict):
                        # Test first horse data
                        first_horse = list(horses_data.values())[0]

                        if isinstance(first_horse, list) and len(first_horse) > 0:
                            perf = first_horse[0]
                            perf_keys = [
                                "date",
                                "track",
                                "finish_position",
                                "speed_figure",
                            ]

                            if all(key in perf for key in perf_keys):
                                self.demo_stats["training_compatibility"] = True

                                return {
                                    "status": "complete",
                                    "result": "✅ Training compatible",
                                    "compatible": True,
                                    "test_details": {
                                        "data_structure": "Valid",
                                        "race_info": "Valid",
                                        "horses_data": "Valid",
                                        "performance_data": "Valid",
                                    },
                                }

            return {
                "status": "complete",
                "result": "❌ Compatibility issues",
                "compatible": False,
                "issues": ["Data structure validation failed"],
            }

        except Exception as e:
            return {
                "status": "failed",
                "result": f"❌ Test failed: {str(e)}",
                "compatible": False,
                "error": str(e),
            }

    async def simulate_api_fallback_scenario(self) -> Dict[str, Any]:
        """Simulate API failure and Playwright fallback scenario."""

        self.console.print("🔄 Simulating API failure and Playwright fallback...")

        await asyncio.sleep(1)

        # Simulate API failure
        api_status = {
            "horseracedatabase_api": "down",
            "backup_api_1": "down",
            "backup_api_2": "limited",
            "playwright_scraper": "active",
        }

        fallback_result = {
            "api_failures": 2,
            "fallback_successful": True,
            "data_source": "playwright_scraper",
            "data_quality": "high",
            "collection_time": "3.2s",
        }

        return {
            "status": "complete",
            "result": "✅ Fallback successful",
            "api_status": api_status,
            "fallback_result": fallback_result,
        }

    async def run_complete_demo(self) -> Dict[str, Any]:
        """Run the complete Playwright auto-download demo."""

        self.demo_stats["start_time"] = time.time()
        self.demo_stats["total_operations"] = 6

        layout = self.create_demo_layout()
        progress_data = {}

        with Live(layout, refresh_per_second=2, screen=True):

            # Step 1: Data Collection
            self.update_header(layout, "🔄 Running")
            self.update_status(
                layout, "Data Collection", "Simulating Playwright scraping"
            )
            self.update_progress(layout, progress_data)
            self.update_results(layout)

            collection_result = await self.simulate_data_collection()
            progress_data["collect_real_data"] = collection_result
            self.demo_stats["successful_operations"] += 1

            # Step 2: Data Validation
            self.update_status(layout, "Data Validation", "Checking data quality")
            self.update_progress(layout, progress_data)
            self.update_results(layout)

            validation_result = await self.simulate_data_validation(
                collection_result["races"]
            )
            progress_data["validate_data"] = validation_result
            self.demo_stats["successful_operations"] += 1

            # Step 3: Data Integration
            self.update_status(
                layout, "Data Integration", "Merging with synthetic data"
            )
            self.update_progress(layout, progress_data)
            self.update_results(layout)

            integration_result = await self.simulate_data_integration(
                collection_result["races"]
            )
            progress_data["integrate_data"] = integration_result
            if integration_result["status"] == "complete":
                self.demo_stats["successful_operations"] += 1

            # Step 4: Training Compatibility Test
            self.update_status(layout, "Training Test", "Testing system compatibility")
            self.update_progress(layout, progress_data)
            self.update_results(layout)

            if integration_result["status"] == "complete":
                training_result = await self.test_training_compatibility(
                    integration_result["integrated_file"]
                )
                progress_data["test_training_compatibility"] = training_result
                if training_result["status"] == "complete":
                    self.demo_stats["successful_operations"] += 1

            # Step 5: Backup Creation
            self.update_status(layout, "Backup Creation", "Creating data backups")
            self.update_progress(layout, progress_data)
            self.update_results(layout)

            await asyncio.sleep(0.5)
            progress_data["backup_existing_data"] = {
                "status": "complete",
                "result": "✅ Backup created",
            }
            self.demo_stats["successful_operations"] += 1

            # Step 6: API Fallback Simulation
            self.update_status(layout, "API Fallback", "Testing fallback scenarios")
            self.update_progress(layout, progress_data)
            self.update_results(layout)

            fallback_result = await self.simulate_api_fallback_scenario()
            progress_data["simulate_api_fallback"] = fallback_result
            self.demo_stats["successful_operations"] += 1

            # Final update
            self.demo_stats["end_time"] = time.time()
            self.demo_stats["duration"] = (
                self.demo_stats["end_time"] - self.demo_stats["start_time"]
            )

            self.update_header(layout, "✅ Complete")
            self.update_status(
                layout, "Demo Complete", "All operations finished successfully"
            )
            self.update_progress(layout, progress_data)
            self.update_results(layout)

            # Keep display for a moment
            await asyncio.sleep(3)

        return {
            "demo_stats": self.demo_stats,
            "progress_data": progress_data,
            "success": self.demo_stats["successful_operations"]
            == self.demo_stats["total_operations"],
        }

    def display_final_summary(self, demo_result: Dict[str, Any]):
        """Display final demo summary."""

        self.console.print("\n" + "=" * 80)
        self.console.print(
            Panel.fit(
                "[bold green]🎉 PLAYWRIGHT AUTO-DOWNLOAD DEMO COMPLETE[/bold green]\n"
                "[white]Real data collection and integration system demonstration[/white]",
                border_style="green",
            )
        )

        # Summary table
        summary_table = Table(title="Demo Summary", show_header=True)
        summary_table.add_column("Component", style="cyan")
        summary_table.add_column("Status", style="green")
        summary_table.add_column("Details", style="white")

        summary_table.add_row(
            "Data Collection",
            "✅ Success",
            f"{self.demo_stats['real_races_collected']} races collected",
        )

        summary_table.add_row(
            "Data Quality",
            "✅ Validated",
            f"{self.demo_stats['data_quality_score']:.1%} quality score",
        )

        summary_table.add_row(
            "Data Integration",
            "✅ Success" if self.demo_stats["integration_success"] else "❌ Failed",
            "Real data merged with synthetic",
        )

        summary_table.add_row(
            "Training Compatible",
            (
                "✅ Compatible"
                if self.demo_stats["training_compatibility"]
                else "❌ Issues"
            ),
            "Works with existing ML systems",
        )

        summary_table.add_row(
            "API Fallback", "✅ Tested", "Playwright backup system validated"
        )

        summary_table.add_row(
            "Total Duration",
            f"{self.demo_stats['duration']:.1f}s",
            f"{self.demo_stats['successful_operations']}/{self.demo_stats['total_operations']} operations successful",
        )

        self.console.print(summary_table)

        # Next steps
        self.console.print(
            Panel(
                "[bold blue]🚀 Next Steps:[/bold blue]\n\n"
                "1. **Deploy to Production**: Use the real Playwright scraper with actual racing websites\n"
                "2. **Configure API Integration**: Set up horseracedatabase.com API when available\n"
                "3. **Schedule Regular Collection**: Automate data collection cycles\n"
                "4. **Monitor Data Quality**: Set up alerts for data quality issues\n"
                "5. **Scale Integration**: Gradually increase real data percentage\n"
                "6. **Optimize Performance**: Fine-tune scraping and processing speed",
                title="Deployment Roadmap",
                border_style="blue",
            )
        )


async def main():
    """Main function to run the complete demo."""

    demo = PlaywrightAutoDownloadDemo()

    console.print(
        Panel.fit(
            "[bold blue]🏇 PLAYWRIGHT AUTO-DOWNLOAD SYSTEM DEMO[/bold blue]\n"
            "[white]Comprehensive demonstration of real data collection and integration[/white]",
            border_style="blue",
        )
    )

    try:
        demo_result = await demo.run_complete_demo()
        demo.display_final_summary(demo_result)

    except KeyboardInterrupt:
        console.print("\n🛑 Demo cancelled by user")
    except Exception as e:
        console.print(f"\n❌ Demo failed: {e}")


if __name__ == "__main__":
    import sys

    sys.path.append(".")

    asyncio.run(main())
