# Dockerfile for Enhanced ML Training System
# Horse Racing AI v2.02 - Docker Integration

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV DEBIAN_FRONTEND=noninteractive

# Create app directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    libpq-dev \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements-ml-models.txt /app/requirements-ml-models.txt

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-ml-models.txt

# Copy application code
COPY docker/ml_training/ /app/docker/ml_training/
COPY docker/pipeline_management/ /app/docker/pipeline_management/
COPY src/ /app/src/
COPY config/ /app/config/

# Create necessary directories
RUN mkdir -p /app/logs /app/models /app/cache /app/data /app/reports

# Copy entrypoint script
COPY docker/ml_training/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import sys; sys.path.append('/app/docker/ml_training'); from enhanced_ml_cycle_manager import DockerLoggingSetup; print('Health check passed')" || exit 1

# Expose monitoring port
EXPOSE 8080

# Run the enhanced ML training system
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["python", "/app/docker/ml_training/enhanced_ml_cycle_manager.py"]
