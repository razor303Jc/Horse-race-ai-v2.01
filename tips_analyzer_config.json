{
    "scraping_config": {
        "user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36",
        "rate_limit_seconds": 3,
        "tips_sources": {
            "racing_post_tips": {
                "url": "https://www.racingpost.com/horse-racing-tips/",
                "name": "Racing Post Tips",
                "selectors": {
                    "tip_cards": "[data-testid='tip-card'], .tip-card, .race-card, .selection-card, .nap-selection, .tip-item, .rp-horseCard, .selection-item",
                    "horse_name": "[data-testid='horse-name'], .horse-name, .selection-name, .runner-name, .horse, .rp-horseCard__horseName, h3, h4",
                    "tipster": "[data-testid='tipster'], .tipster-name, .author, .expert, .pundit, .by-line, .rp-tipCard__tipster",
                    "race_info": "[data-testid='race-info'], .race-time, .course, .race-details, .meeting, .venue, .rp-raceCard__time, .rp-raceCard__course",
                    "odds": "[data-testid='odds'], .odds, .price, .sp, .starting-price, .best-odds, .rp-price",
                    "reasoning": "[data-testid='tip-reason'], .tip-reason, .comment, .analysis, .preview, .form-comment, .rp-tipCard__comment"
                }
            },
            "sky_sports_tips": {
                "url": "https://www.skysports.com/racing/news",
                "name": "Sky Sports Racing Tips",
                "selectors": {
                    "tip_cards": ".tip-card, .race-card, .selection",
                    "horse_name": ".horse-name, .selection-name, h3, h4",
                    "tipster": ".tipster, .author, .expert",
                    "race_info": ".race-info, .meeting, .course",
                    "odds": ".odds, .price",
                    "reasoning": ".tip-comment, .analysis"
                }
            },
            "sporting_life_tips": {
                "url": "https://www.sportinglife.com/racing/news",
                "name": "Sporting Life Tips",
                "selectors": {
                    "tip_cards": ".tip-card, .selection-card",
                    "horse_name": ".horse-name, .selection",
                    "tipster": ".tipster, .expert",
                    "race_info": ".race-details, .meeting",
                    "odds": ".odds, .price",
                    "reasoning": ".tip-reason, .comment"
                }
            },
            "at_the_races_tips": {
                "url": "https://www.attheraces.com/tips",
                "name": "At The Races Tips",
                "selectors": {
                    "tip_cards": ".tip-item, .selection",
                    "horse_name": ".horse, .selection-name",
                    "tipster": ".tipster, .pundit",
                    "race_info": ".race-info, .meeting",
                    "odds": ".odds, .price",
                    "reasoning": ".comment, .analysis"
                }
            },
            "timeform_tips": {
                "url": "https://www.timeform.com/horse-racing/tips",
                "name": "Timeform Tips", 
                "selectors": {
                    "tip_cards": ".tip-card, .race-card",
                    "horse_name": ".horse-name, .selection",
                    "tipster": ".expert, .analyst",
                    "race_info": ".race-details, .meeting",
                    "odds": ".odds, .price",
                    "reasoning": ".analysis, .comment"
                }
            }
        }
    },
    "analyzer_config": {
        "rate_limit_seconds": 3,
        "max_tips_per_source": 15,
        "confidence_threshold": 0.6,
        "value_threshold": 0.6,
        "timeout_seconds": 120
    },
    "database_config": {
        "backup_enabled": true,
        "cleanup_old_data": true,
        "retention_days": 30
    },
    "reporting_config": {
        "generate_daily_reports": true,
        "report_directory": "reports/daily_tips",
        "include_charts": false
    }
}
