  {
    "id": "ml-analytics-api",
    "type": "http in",
    "z": "ml-analytics-tab",
    "name": "ML Analytics API",
    "url": "/api/ml-analytics/:action",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 120,
    "y": 160,
    "wires": [["ml-analytics-controller"]]
  },
  {
    "id": "ml-analytics-controller",
    "type": "function",
    "z": "ml-analytics-tab",
    "name": "ML Analytics Controller",
    "func": "const action = msg.req.params.action;\nconst timestamp = new Date().toISOString();\nconst requestBody = msg.payload || {};\n\nswitch(action) {\n    case 'initialize-systems':\n        msg.payload = {\n            action: 'initialize_all_systems',\n            timestamp: timestamp,\n            systems: ['form_scores', 'power_ratings', 'speed_analysis', 'pace_analysis', 'z_scores', 'monte_carlo'],\n            status: 'initializing',\n            database: 'advanced_horse_racing_db'\n        };\n        break;\n        \n    case 'calculate-form-scores':\n        msg.payload = {\n            action: 'calculate_form_scores',\n            timestamp: timestamp,\n            parameters: {\n                historical_window: requestBody.window || 30,\n                weight_decay: requestBody.weight_decay || 0.8,\n                minimum_races: requestBody.min_races || 3\n            },\n            status: 'processing'\n        };\n        break;\n        \n    case 'generate-power-ratings':\n        msg.payload = {\n            action: 'generate_power_ratings',\n            timestamp: timestamp,\n            parameters: {\n                algorithm: requestBody.algorithm || 'custom',\n                track_adjustments: requestBody.track_adj || true,\n                class_adjustments: requestBody.class_adj || true\n            },\n            status: 'generating'\n        };\n        break;\n        \n    default:\n        msg.payload = {\n            error: 'Unknown ML analytics action: ' + action,\n            available_actions: [\n                'initialize-systems', 'calculate-form-scores', 'generate-power-ratings'\n            ]\n        };\n        msg.statusCode = 400;\n        return msg;\n}\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 160,
    "wires": [["ml-analytics-processor"]]
  },
  {
    "id": "ml-analytics-processor",
    "type": "function",
    "z": "ml-analytics-tab",
    "name": "ML Analytics Processor",
    "func": "const action = msg.payload.action;\nconst timestamp = new Date().toISOString();\n\nswitch(action) {\n    case 'initialize_all_systems':\n        msg.payload = {\n            ...msg.payload,\n            status: 'completed',\n            systems_initialized: 6,\n            database_tables_created: [\n                'form_scores',\n                'power_ratings', \n                'speed_ratings',\n                'pace_analysis',\n                'z_scores',\n                'monte_carlo_simulations'\n            ],\n            processing_time: '2.3s'\n        };\n        break;\n        \n    case 'calculate_form_scores':\n        msg.payload = {\n            ...msg.payload,\n            status: 'completed',\n            horses_analyzed: Math.floor(Math.random() * 500) + 200,\n            average_form_score: (Math.random() * 40 + 60).toFixed(2),\n            processing_time: '3.1s'\n        };\n        break;\n        \n    case 'generate_power_ratings':\n        msg.payload = {\n            ...msg.payload,\n            status: 'completed',\n            horses_rated: Math.floor(Math.random() * 400) + 150,\n            average_power_rating: (Math.random() * 30 + 70).toFixed(2),\n            processing_time: '2.7s'\n        };\n        break;\n        \n    default:\n        msg.payload.status = 'error';\n        msg.payload.error = 'Unknown action: ' + action;\n}\n\nreturn msg;",
