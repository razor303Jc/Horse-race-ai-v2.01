  {
    "id": "ml-analytics-template",
    "type": "template",
    "z": "ml-analytics-tab",
    "name": "ML Analytics HTML",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "mustache",
    "template": "<!DOCTYPE html>\n<html>\n<head>\n    <title>Horse Racing AI - Advanced ML Analytics</title>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: 'Segoe UI', Arial, sans-serif; background: #0a0a0a; color: #fff; }\n        .navbar { background: #1a1a2e; border-bottom: 1px solid #333; padding: 0; }\n        .navbar-content { display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto; padding: 0 20px; }\n        .navbar-brand { display: flex; align-items: center; color: #ff6b35; font-size: 18px; font-weight: bold; }\n        .navbar-brand .brand-icon { margin-right: 10px; font-size: 24px; }\n        .navbar-nav { display: flex; list-style: none; }\n        .nav-item { margin: 0; }\n        .nav-link { display: block; padding: 15px 20px; color: #aaa; text-decoration: none; transition: all 0.3s; border-bottom: 2px solid transparent; }\n        .nav-link:hover { color: #fff; background: rgba(255,255,255,0.1); }\n        .nav-link.active { color: #ff6b35; border-bottom-color: #ff6b35; background: rgba(255,107,53,0.1); }\n        .header { background: linear-gradient(135deg, #1a1a2e, #16213e); padding: 20px; text-align: center; border-bottom: 2px solid #ff6b35; }\n        .nav-tabs { display: flex; background: #1a1a2e; border-bottom: 1px solid #333; }\n        .tab-btn { background: none; border: none; color: #aaa; padding: 15px 20px; cursor: pointer; border-bottom: 2px solid transparent; }\n        .tab-btn.active { color: #ff6b35; border-bottom-color: #ff6b35; }\n        .tab-btn:hover { color: #fff; }\n        .tab-content { display: none; padding: 20px; }\n        .tab-content.active { display: block; }\n        .container { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }\n        .full-width { grid-column: 1 / -1; }\n        .half-width { grid-column: span 2; }\n        .panel { background: #1a1a2e; border: 1px solid #333; border-radius: 8px; padding: 20px; }\n        .panel h3 { color: #ff6b35; margin-bottom: 15px; border-bottom: 1px solid #333; padding-bottom: 10px; }\n        .metric { display: flex; justify-content: space-between; margin: 10px 0; align-items: center; }\n        .status-green { color: #00ff88; }\n        .status-red { color: #ff4444; }\n        .status-yellow { color: #ffaa00; }\n        .status-orange { color: #ff6b35; }\n        .btn { background: #ff6b35; color: #fff; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; margin: 5px; }\n        .btn:hover { background: #e55a2b; }\n        .btn:disabled { background: #555; color: #888; cursor: not-allowed; }\n        .btn-secondary { background: #666; }\n        .btn-secondary:hover { background: #555; }\n        .btn-danger { background: #ff4444; }\n        .btn-danger:hover { background: #cc3333; }\n        .btn-success { background: #00ff88; color: #000; }\n        .btn-success:hover { background: #00cc70; }\n        .progress-bar { width: 100%; height: 20px; background: #333; border-radius: 10px; overflow: hidden; margin: 10px 0; }\n        .progress-fill { height: 100%; background: linear-gradient(90deg, #ff6b35, #e55a2b); transition: width 0.3s; }\n        .data-table { width: 100%; border-collapse: collapse; margin-top: 10px; }\n        .data-table th, .data-table td { border: 1px solid #333; padding: 8px; text-align: left; }\n        .data-table th { background: #2a2a3e; color: #ff6b35; }\n        .data-table tr:nth-child(even) { background: #1a1a2e; }\n        .data-table tr:hover { background: #2a2a3e; }\n        .log-area { background: #000; border: 1px solid #333; padding: 10px; height: 200px; overflow-y: auto; font-family: monospace; font-size: 12px; }\n        .ml-card { background: #2a2a3e; border: 1px solid #444; border-radius: 6px; padding: 15px; margin: 10px 0; }\n        .ml-card h4 { color: #ff6b35; margin-bottom: 10px; }\n        .analytics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 15px; }\n        .score-display { font-size: 24px; font-weight: bold; text-align: center; padding: 10px; background: #333; border-radius: 8px; }\n        .score-excellent { color: #00ff88; }\n        .score-good { color: #ffaa00; }\n        .score-poor { color: #ff4444; }\n        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.7; } 100% { opacity: 1; } }\n        .processing { animation: pulse 1.5s infinite; }\n    </style>\n</head>\n<body>\n    <nav class=\"navbar\">\n        <div class=\"navbar-content\">\n            <div class=\"navbar-brand\">\n                <span class=\"brand-icon\">🧠</span>\n                Advanced ML Analytics\n            </div>\n            <ul class=\"navbar-nav\">\n                <li class=\"nav-item\">\n                    <a class=\"nav-link\" href=\"/c2\">🎯 C2 Command</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link\" href=\"/data-processing\">📊 Data Processing</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link active\" href=\"/ml-analytics\">🧠 ML Analytics</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link\" href=\"/admin\">⚙️ Node-RED</a>\n                </li>\n            </ul>\n        </div>\n    </nav>\n    \n    <div class=\"header\">\n        <h1>🧠 Advanced ML Analytics Framework</h1>\n        <p>Form Scores • Power Ratings • Speed Analysis • Pace Analytics • Z-Scores • Monte Carlo</p>\n    </div>\n    \n    <div class=\"nav-tabs\">\n        <button class=\"tab-btn active\" onclick=\"switchTab('overview')\">📊 Overview</button>\n        <button class=\"tab-btn\" onclick=\"switchTab('form-scores')\">📈 Form Scores</button>\n        <button class=\"tab-btn\" onclick=\"switchTab('power-ratings')\">⚡ Power Ratings</button>\n        <button class=\"tab-btn\" onclick=\"switchTab('speed-analysis')\">🏃 Speed Analysis</button>\n        <button class=\"tab-btn\" onclick=\"switchTab('pace-analysis')\">⏱️ Pace Analysis</button>\n        <button class=\"tab-btn\" onclick=\"switchTab('z-scores')\">📐 Z-Scores</button>\n        <button class=\"tab-btn\" onclick=\"switchTab('monte-carlo')\">🎲 Monte Carlo</button>\n    </div>\n    \n    <div id=\"overview-tab\" class=\"tab-content active\">\n        <div class=\"container\">\n            <div class=\"panel\">\n                <h3>🔧 ML Analytics Status</h3>\n                <div class=\"metric\">\n                    <span>Form Scores Engine:</span>\n                    <span id=\"form-status\" class=\"status-red\">● Offline</span>\n                </div>\n                <div class=\"metric\">\n                    <span>Power Ratings System:</span>\n                    <span id=\"power-status\" class=\"status-red\">● Offline</span>\n                </div>\n                <div class=\"metric\">\n                    <span>Speed Analysis:</span>\n                    <span id=\"speed-status\" class=\"status-red\">● Offline</span>\n                </div>\n                <div class=\"metric\">\n                    <span>Pace Analytics:</span>\n                    <span id=\"pace-status\" class=\"status-red\">● Offline</span>\n                </div>\n                <div class=\"metric\">\n                    <span>Z-Scores Framework:</span>\n                    <span id=\"zscore-status\" class=\"status-red\">● Offline</span>\n                </div>\n                <div class=\"metric\">\n                    <span>Monte Carlo Engine:</span>\n                    <span id=\"monte-status\" class=\"status-red\">● Offline</span>\n                </div>\n            </div>\n            \n            <div class=\"panel\">\n                <h3>🚀 Quick Actions</h3>\n                <button class=\"btn\" onclick=\"initializeAllSystems()\">Initialize All Systems</button>\n                <button class=\"btn btn-success\" onclick=\"runFullAnalysis()\">Run Full Analysis</button>\n                <button class=\"btn btn-secondary\" onclick=\"validateModels()\">Validate Models</button>\n                <button class=\"btn btn-danger\" onclick=\"resetAnalytics()\">Reset Analytics</button>\n                \n                <div style=\"margin-top: 20px;\">\n                    <strong>System Initialization Progress:</strong>\n                    <div class=\"progress-bar\">\n                        <div class=\"progress-fill\" id=\"init-progress\" style=\"width: 0%\"></div>\n                    </div>\n                    <span id=\"init-status\">Ready to initialize</span>\n                </div>\n            </div>\n            \n            <div class=\"panel\">\n                <h3>📈 Performance Metrics</h3>\n                <div class=\"metric\">\n                    <span>Models Trained:</span>\n                    <span id=\"models-trained\">0 / 6</span>\n                </div>\n                <div class=\"metric\">\n                    <span>Predictions Generated:</span>\n                    <span id=\"predictions-count\">0</span>\n                </div>\n                <div class=\"metric\">\n                    <span>Accuracy Rate:</span>\n                    <span id=\"accuracy-rate\">0%</span>\n                </div>\n                <div class=\"metric\">\n                    <span>Processing Speed:</span>\n                    <span id=\"processing-speed\">0 races/min</span>\n                </div>\n                <div class=\"metric\">\n                    <span>Database Size:</span>\n                    <span id=\"db-size\">0 MB</span>\n                </div>\n            </div>\n            \n            <div class=\"panel full-width\">\n                <h3>🧠 ML Analytics Components</h3>\n                <div class=\"analytics-grid\">\n                    <div class=\"ml-card\">\n                        <h4>📈 Form Scores</h4>\n                        <div class=\"score-display score-poor\" id=\"form-score\">0.0</div>\n                        <div class=\"metric\"><span>Last Updated:</span><span>Never</span></div>\n                        <div class=\"metric\"><span>Records:</span><span>0</span></div>\n                        <button class=\"btn\" onclick=\"calculateFormScores()\">Calculate</button>\n                    </div>\n                    \n                    <div class=\"ml-card\">\n                        <h4>⚡ Power Ratings</h4>\n                        <div class=\"score-display score-poor\" id=\"power-rating\">0.0</div>\n                        <div class=\"metric\"><span>Last Updated:</span><span>Never</span></div>\n                        <div class=\"metric\"><span>Horses Rated:</span><span>0</span></div>\n                        <button class=\"btn\" onclick=\"generatePowerRatings()\">Generate</button>\n                    </div>\n                    \n                    <div class=\"ml-card\">\n                        <h4>🏃 Speed Analysis</h4>\n                        <div class=\"score-display score-poor\" id=\"speed-rating\">0.0</div>\n                        <div class=\"metric\"><span>Last Updated:</span><span>Never</span></div>\n                        <div class=\"metric\"><span>Speed Records:</span><span>0</span></div>\n                        <button class=\"btn\" onclick=\"analyzeSpeed()\">Analyze</button>\n                    </div>\n                    \n                    <div class=\"ml-card\">\n                        <h4>⏱️ Pace Analysis</h4>\n                        <div class=\"score-display score-poor\" id=\"pace-rating\">0.0</div>\n                        <div class=\"metric\"><span>Last Updated:</span><span>Never</span></div>\n                        <div class=\"metric\"><span>Pace Profiles:</span><span>0</span></div>\n                        <button class=\"btn\" onclick=\"analyzePace()\">Analyze</button>\n                    </div>\n                    \n                    <div class=\"ml-card\">\n                        <h4>📐 Z-Scores</h4>\n                        <div class=\"score-display score-poor\" id=\"zscore-rating\">0.0</div>\n                        <div class=\"metric\"><span>Last Updated:</span><span>Never</span></div>\n                        <div class=\"metric\"><span>Statistical Models:</span><span>0</span></div>\n                        <button class=\"btn\" onclick=\"calculateZScores()\">Calculate</button>\n                    </div>\n                    \n                    <div class=\"ml-card\">\n                        <h4>🎲 Monte Carlo</h4>\n                        <div class=\"score-display score-poor\" id=\"monte-rating\">0.0</div>\n                        <div class=\"metric\"><span>Last Updated:</span><span>Never</span></div>\n                        <div class=\"metric\"><span>Simulations:</span><span>0</span></div>\n                        <button class=\"btn\" onclick=\"runMonteCarloSim()\">Simulate</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    \n    <div id=\"form-scores-tab\" class=\"tab-content\">\n        <div class=\"container\">\n            <div class=\"panel\">\n                <h3>📈 Form Scores Configuration</h3>\n                <div class=\"metric\">\n                    <span>Historical Window:</span>\n                    <select class=\"btn\" id=\"form-window\">\n                        <option value=\"30\">30 days</option>\n                        <option value=\"60\">60 days</option>\n                        <option value=\"90\">90 days</option>\n                    </select>\n                </div>\n                <div class=\"metric\">\n                    <span>Weight Decay:</span>\n                    <input type=\"range\" min=\"0.1\" max=\"1.0\" step=\"0.1\" value=\"0.8\" id=\"weight-decay\">\n                    <span id=\"weight-value\">0.8</span>\n                </div>\n                <div class=\"metric\">\n                    <span>Minimum Races:</span>\n                    <input type=\"number\" min=\"1\" max=\"10\" value=\"3\" class=\"btn\" id=\"min-races\">\n                </div>\n                <button class=\"btn\" onclick=\"updateFormConfig()\">Update Config</button>\n                <button class=\"btn btn-success\" onclick=\"calculateFormScores()\">Calculate All</button>\n            </div>\n        </div>\n    </div>\n    \n    <script>\n        function switchTab(tabName) {\n            document.querySelectorAll('.tab-content').forEach(tab => {\n                tab.classList.remove('active');\n            });\n            document.querySelectorAll('.tab-btn').forEach(btn => {\n                btn.classList.remove('active');\n            });\n            \n            document.getElementById(tabName + '-tab').classList.add('active');\n            event.target.classList.add('active');\n        }\n        \n        function initializeAllSystems() {\n            updateProgress('init-progress', 0);\n            document.getElementById('init-status').textContent = 'Initializing...';\n            \n            const systems = ['form', 'power', 'speed', 'pace', 'zscore', 'monte'];\n            let progress = 0;\n            \n            systems.forEach((system, index) => {\n                setTimeout(() => {\n                    progress = ((index + 1) / systems.length) * 100;\n                    updateProgress('init-progress', progress);\n                    updateSystemStatus(system + '-status', 'online');\n                    \n                    if (index === systems.length - 1) {\n                        document.getElementById('init-status').textContent = 'All systems online';\n                    }\n                }, (index + 1) * 1000);\n            });\n        }\n        \n        function runFullAnalysis() {\n            calculateFormScores();\n            setTimeout(() => generatePowerRatings(), 2000);\n            setTimeout(() => analyzeSpeed(), 4000);\n            setTimeout(() => analyzePace(), 6000);\n            setTimeout(() => calculateZScores(), 8000);\n            setTimeout(() => runMonteCarloSim(), 10000);\n        }\n        \n        function calculateFormScores() {\n            const element = document.getElementById('form-score');\n            element.textContent = 'Calculating...';\n            element.className = 'score-display processing';\n            \n            setTimeout(() => {\n                const score = (Math.random() * 40 + 60).toFixed(1);\n                element.textContent = score;\n                element.className = `score-display ${getScoreClass(score)}`;\n                updateMetric('models-trained', '1 / 6');\n            }, 3000);\n        }\n        \n        function generatePowerRatings() {\n            const element = document.getElementById('power-rating');\n            element.textContent = 'Generating...';\n            element.className = 'score-display processing';\n            \n            setTimeout(() => {\n                const rating = (Math.random() * 30 + 70).toFixed(1);\n                element.textContent = rating;\n                element.className = `score-display ${getScoreClass(rating)}`;\n                updateMetric('models-trained', '2 / 6');\n            }, 2500);\n        }\n        \n        function analyzeSpeed() {\n            const element = document.getElementById('speed-rating');\n            element.textContent = 'Analyzing...';\n            element.className = 'score-display processing';\n            \n            setTimeout(() => {\n                const speed = (Math.random() * 25 + 75).toFixed(1);\n                element.textContent = speed;\n                element.className = `score-display ${getScoreClass(speed)}`;\n                updateMetric('models-trained', '3 / 6');\n            }, 3500);\n        }\n        \n        function analyzePace() {\n            const element = document.getElementById('pace-rating');\n            element.textContent = 'Analyzing...';\n            element.className = 'score-display processing';\n            \n            setTimeout(() => {\n                const pace = (Math.random() * 20 + 65).toFixed(1);\n                element.textContent = pace;\n                element.className = `score-display ${getScoreClass(pace)}`;\n                updateMetric('models-trained', '4 / 6');\n            }, 2800);\n        }\n        \n        function calculateZScores() {\n            const element = document.getElementById('zscore-rating');\n            element.textContent = 'Calculating...';\n            element.className = 'score-display processing';\n            \n            setTimeout(() => {\n                const zscore = (Math.random() * 2 - 1).toFixed(2);\n                element.textContent = zscore;\n                element.className = 'score-display score-good';\n                updateMetric('models-trained', '5 / 6');\n            }, 4000);\n        }\n        \n        function runMonteCarloSim() {\n            const element = document.getElementById('monte-rating');\n            element.textContent = 'Simulating...';\n            element.className = 'score-display processing';\n            \n            setTimeout(() => {\n                const probability = (Math.random() * 0.3 + 0.4).toFixed(3);\n                element.textContent = probability;\n                element.className = 'score-display score-excellent';\n                updateMetric('models-trained', '6 / 6');\n                updateMetric('predictions-count', Math.floor(Math.random() * 100 + 50));\n                updateMetric('accuracy-rate', (Math.random() * 25 + 70).toFixed(1) + '%');\n            }, 5000);\n        }\n        \n        function getScoreClass(score) {\n            const numScore = parseFloat(score);\n            if (numScore >= 80) return 'score-excellent';\n            if (numScore >= 60) return 'score-good';\n            return 'score-poor';\n        }\n        \n        function updateSystemStatus(elementId, status) {\n            const element = document.getElementById(elementId);\n            if (status === 'online') {\n                element.textContent = '● Online';\n                element.className = 'status-green';\n            } else {\n                element.textContent = '● Offline';\n                element.className = 'status-red';\n            }\n        }\n        \n        function updateProgress(elementId, percentage) {\n            document.getElementById(elementId).style.width = percentage + '%';\n        }\n        \n        function updateMetric(elementId, value) {\n            const element = document.getElementById(elementId);\n            if (element) element.textContent = value;\n        }\n        \n        function validateModels() {\n            setTimeout(() => {\n                console.log('All models validated successfully');\n            }, 2000);\n        }\n        \n        function resetAnalytics() {\n            if (confirm('Are you sure you want to reset all analytics data?')) {\n                ['form-score', 'power-rating', 'speed-rating', 'pace-rating', 'zscore-rating', 'monte-rating'].forEach(id => {\n                    const element = document.getElementById(id);\n                    element.textContent = '0.0';\n                    element.className = 'score-display score-poor';\n                });\n                \n                ['form-status', 'power-status', 'speed-status', 'pace-status', 'zscore-status', 'monte-status'].forEach(id => {\n                    updateSystemStatus(id, 'offline');\n                });\n                \n                updateProgress('init-progress', 0);\n                document.getElementById('init-status').textContent = 'Ready to initialize';\n                updateMetric('models-trained', '0 / 6');\n            }\n        }\n    </script>\n</body>\n</html>",
    "output": "str",
    "x": 340,
    "y": 80,
    "wires": [["ml-analytics-response"]]
