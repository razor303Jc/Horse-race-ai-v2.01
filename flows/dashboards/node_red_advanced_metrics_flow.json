    {
        "id": "schedule_metrics",
        "type": "inject",
        "z": "advanced_metrics_flow",
        "name": "Daily at 2 AM",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "00 02 * * *",
        "once": false,
        "onceDelay": 0.1,
        "topic": "scheduled_metrics",
        "payload": "daily_run",
        "payloadType": "str",
        "x": 180,
        "y": 200,
        "wires": [
            [
                "exec_metrics"
            ]
        ]
    },
    {
        "id": "metrics_notification",
        "type": "function",
        "z": "advanced_metrics_flow",
        "name": "Process Results",
        "func": "// Parse the output and create notification\nconst output = msg.payload.toString();\n\n// Check for success indicators\nif (output.includes('SUCCESS: Advanced metrics populated!')) {\n    msg.payload = {\n        status: 'success',\n        message: 'Advanced metrics calculation completed successfully',\n        timestamp: new Date().toISOString(),\n        details: output\n    };\n    msg.topic = 'metrics_success';\n} else if (output.includes('ERROR') || output.includes('FAILED')) {\n    msg.payload = {\n        status: 'error',\n        message: 'Advanced metrics calculation failed',\n        timestamp: new Date().toISOString(),\n        details: output\n    };\n    msg.topic = 'metrics_error';\n} else {\n    msg.payload = {\n        status: 'info',\n        message: 'Advanced metrics calculation in progress',\n        timestamp: new Date().toISOString(),\n        details: output\n    };\n    msg.topic = 'metrics_info';\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 280,
        "wires": [
            [
                "final_debug"
            ]
        ]
    },
    {
        "id": "final_debug",
        "type": "debug",
        "z": "advanced_metrics_flow",
        "name": "Final Result",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 720,
        "y": 280,
        "wires": []
    }
]
