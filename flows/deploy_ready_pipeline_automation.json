[
  {
    "id": "pipeline-automation-tab",
    "type": "tab",
    "label": "🚀 Pipeline Automation",
    "disabled": false,
    "info": "Python Script Automation via Exec Nodes - Production Ready"
  },
  {
    "id": "manual-pipeline-exec",
    "type": "exec",
    "z": "pipeline-automation-tab",
    "command": "docker",
    "addpay": false,
    "append": "exec horse_racing_data_pipeline_clean python /app/tools/manual_pipeline_trigger.py --all",
    "useSpawn": false,
    "timer": "",
    "winHide": false,
    "oldrc": false,
    "name": "🔄 Manual Pipeline Trigger",
    "env": [
      {
        "name": "PYTHONUNBUFFERED",
        "value": "1",
        "type": "str"
      }
    ],
    "timeout": "300",
    "killSignal": "SIGTERM",
    "x": 380,
    "y": 120,
    "wires": [
      ["pipeline-success-output"],
      ["pipeline-error-output"],
      ["pipeline-exit-output"]
    ]
  },
  {
    "id": "trigger-pipeline-inject",
    "type": "inject",
    "z": "pipeline-automation-tab",
    "name": "🎯 TRIGGER PIPELINE",
    "props": [
      {
        "p": "payload",
        "v": "{\"source\":\"manual\",\"timestamp\":\"$moment().toISOString()\"}",
        "vt": "json"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "x": 150,
    "y": 120,
    "wires": [["manual-pipeline-exec"]]
  },
  {
    "id": "pipeline-success-output",
    "type": "debug",
    "z": "pipeline-automation-tab",
    "name": "✅ SUCCESS",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 600,
    "y": 80,
    "wires": []
  },
  {
    "id": "pipeline-error-output",
    "type": "debug",
    "z": "pipeline-automation-tab",
    "name": "❌ ERROR",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 590,
    "y": 120,
    "wires": []
  },
  {
    "id": "pipeline-exit-output",
    "type": "debug",
    "z": "pipeline-automation-tab",
    "name": "🔄 EXIT CODE",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 610,
    "y": 160,
    "wires": []
  },
  {
    "id": "api-pipeline-trigger",
    "type": "http in",
    "z": "pipeline-automation-tab",
    "name": "API: Trigger Pipeline",
    "url": "/api/pipeline/trigger",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 150,
    "y": 200,
    "wires": [["api-handler"]]
  },
  {
    "id": "api-handler",
    "type": "function",
    "z": "pipeline-automation-tab",
    "name": "API Handler",
    "func": "// Handle API request to trigger pipeline\nmsg.payload = {\n    source: 'api',\n    timestamp: new Date().toISOString(),\n    request_id: msg._msgid\n};\n\n// Send immediate response\nmsg.statusCode = 202;\nmsg.headers = {'Content-Type': 'application/json'};\n\n// Return both response and trigger\nreturn [{\n    payload: {\n        success: true,\n        message: 'Pipeline triggered',\n        request_id: msg._msgid\n    },\n    statusCode: 202,\n    headers: {'Content-Type': 'application/json'}\n}, msg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 200,
    "wires": [["api-response"], ["manual-pipeline-exec"]]
  },
  {
    "id": "api-response",
    "type": "http response",
    "z": "pipeline-automation-tab",
    "name": "API Response",
    "statusCode": "",
    "headers": {},
    "x": 600,
    "y": 200,
    "wires": []
  },
  {
