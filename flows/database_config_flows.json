  },
  {
    "id": "db-health-function",
    "type": "function",
    "z": "database-config-tab",
    "name": "Check DB Health",
    "func": "// Database health check function\nconst databases = [\n  { name: 'main', config: 'postgres-main-db' },\n  { name: 'cards', config: 'postgres-cards-db' },\n  { name: 'results', config: 'postgres-results-db' }, \n  { name: 'advanced', config: 'postgres-advanced-db' }\n];\n\n// Set query for health check\nmsg.query = 'SELECT 1 as healthy, current_timestamp as check_time';\nmsg.databases = databases;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 380,
    "y": 100,
    "wires": [["db-main-query"]]
  },
