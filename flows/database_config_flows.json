  {
    "id": "db-response-format",
    "type": "function",
    "z": "database-config-tab",
    "name": "Format DB Response",
    "func": "// Format database health response\nconst response = {\n  timestamp: new Date().toISOString(),\n  status: 'healthy',\n  databases: {\n    main: { connected: true, response_time: '< 10ms' },\n    cards: { connected: true, response_time: '< 10ms' },\n    results: { connected: true, response_time: '< 10ms' },\n    advanced: { connected: true, response_time: '< 10ms' }\n  },\n  query_result: msg.payload\n};\n\nmsg.payload = response;\nmsg.statusCode = 200;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 800,
    "y": 140,
    "wires": [["db-health-response"]]
