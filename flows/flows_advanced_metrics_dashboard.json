  {
    "id": "template-metrics-dashboard",
    "type": "template",
    "z": "advanced-metrics-tab",
    "name": "Advanced Metrics HTML",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "mustache",
    "template": "<!DOCTYPE html>\n<html>\n<head>\n    <title>Horse Racing AI - Advanced Metrics</title>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: 'Segoe UI', Arial, sans-serif; background: #0a0a0a; color: #fff; }\n        .navbar { background: #1a1a2e; border-bottom: 1px solid #333; padding: 0; }\n        .navbar-content { display: flex; justify-content: space-between; align-items: center; max-width: 1400px; margin: 0 auto; padding: 0 20px; }\n        .navbar-brand { display: flex; align-items: center; color: #aa44ff; font-size: 18px; font-weight: bold; }\n        .navbar-brand .brand-icon { margin-right: 10px; font-size: 24px; }\n        .navbar-nav { display: flex; list-style: none; }\n        .nav-item { margin: 0; }\n        .nav-link { display: block; padding: 15px 20px; color: #aaa; text-decoration: none; transition: all 0.3s; border-bottom: 2px solid transparent; }\n        .nav-link:hover { color: #fff; background: rgba(255,255,255,0.1); }\n        .nav-link.active { color: #aa44ff; border-bottom-color: #aa44ff; background: rgba(170,68,255,0.1); }\n        .header { background: linear-gradient(135deg, #1a1a2e, #2a1a3e); padding: 30px; text-align: center; border-bottom: 2px solid #aa44ff; }\n        .container { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; padding: 20px; }\n        .panel { background: #1a1a2e; border: 1px solid #333; border-radius: 8px; padding: 20px; }\n        .panel.wide { grid-column: span 2; }\n        .panel.full { grid-column: span 3; }\n        .panel h3 { color: #aa44ff; margin-bottom: 15px; border-bottom: 1px solid #333; padding-bottom: 10px; }\n        .metrics-panel { border: 2px solid #aa44ff; background: linear-gradient(135deg, #1a1a2e, #2a1a3e); }\n        .status-green { color: #00ff88; }\n        .status-red { color: #ff4444; }\n        .status-yellow { color: #ffaa00; }\n        .status-purple { color: #aa44ff; }\n        .metric { display: flex; justify-content: space-between; margin: 10px 0; }\n        .btn { background: #aa44ff; color: #fff; border: none; padding: 10px 16px; border-radius: 4px; cursor: pointer; margin: 5px; }\n        .btn:hover { background: #8833cc; }\n        .btn-secondary { background: #666; color: #fff; }\n        .btn-secondary:hover { background: #555; }\n        .btn-success { background: #00ff88; color: #000; }\n        .btn-success:hover { background: #00cc70; }\n        .log-area { background: #000; border: 1px solid #333; padding: 15px; height: 250px; overflow-y: auto; font-family: monospace; font-size: 12px; }\n        .progress-bar { width: 100%; height: 20px; background: #333; border-radius: 10px; overflow: hidden; margin: 10px 0; }\n        .progress-fill { height: 100%; background: linear-gradient(90deg, #aa44ff, #8833cc); transition: width 0.3s; }\n        .metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 15px; }\n        .metrics-card { background: #2a2a3e; border: 1px solid #444; border-radius: 6px; padding: 15px; }\n        .metrics-card h4 { color: #aa44ff; margin-bottom: 10px; }\n        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; }\n        .stat-card { background: #2a2a3e; border: 1px solid #444; border-radius: 6px; padding: 15px; text-align: center; }\n        .stat-value { font-size: 24px; font-weight: bold; color: #aa44ff; }\n        .stat-label { color: #aaa; margin-top: 5px; }\n        .config-item { display: flex; justify-content: space-between; align-items: center; margin: 10px 0; padding: 10px; background: #2a2a3e; border-radius: 4px; }\n    </style>\n</head>\n<body>\n    <nav class=\"navbar\">\n        <div class=\"navbar-content\">\n            <div class=\"navbar-brand\">\n                <span class=\"brand-icon\">⚡</span>\n                Horse Racing AI - Advanced Metrics\n            </div>\n            <ul class=\"navbar-nav\">\n                <li class=\"nav-item\">\n                    <a class=\"nav-link\" href=\"/c2\">🎯 C2 Command</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link\" href=\"/data-processing\">📊 Data Processing</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link\" href=\"/admin\">⚙️ Node-RED</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link active\" href=\"/metrics\">⚡ Advanced Metrics</a>\n                </li>\n            </ul>\n        </div>\n    </nav>\n    \n    <div class=\"header\">\n        <h1>⚡ Horse Racing AI - Advanced Metrics Center</h1>\n        <p>Speed Ratings, Power Ratings & Monte Carlo Simulations</p>\n    </div>\n    \n    <div class=\"container\">\n        <!-- Metrics Overview Panel -->\n        <div class=\"panel full\">\n            <h3>📊 Metrics Overview</h3>\n            <div class=\"stats-grid\">\n                <div class=\"stat-card\">\n                    <div class=\"stat-value\" id=\"total-speed-ratings\">0</div>\n                    <div class=\"stat-label\">Speed Ratings Calculated</div>\n                </div>\n                <div class=\"stat-card\">\n                    <div class=\"stat-value\" id=\"total-power-ratings\">0</div>\n                    <div class=\"stat-label\">Power Ratings Calculated</div>\n                </div>\n                <div class=\"stat-card\">\n                    <div class=\"stat-value\" id=\"total-monte-carlo\">0</div>\n                    <div class=\"stat-label\">Monte Carlo Simulations</div>\n                </div>\n                <div class=\"stat-card\">\n                    <div class=\"stat-value\" id=\"total-records\">0</div>\n                    <div class=\"stat-label\">Total Records Processed</div>\n                </div>\n                <div class=\"stat-card\">\n                    <div class=\"stat-value\" id=\"last-update-time\">Never</div>\n                    <div class=\"stat-label\">Last Update</div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Speed Ratings Panel -->\n        <div class=\"panel metrics-panel\">\n            <h3>⚡ Speed Ratings Calculator</h3>\n            <div class=\"metric\">\n                <span>Status:</span>\n                <span id=\"speed-status\" class=\"status-yellow\">Ready</span>\n            </div>\n            <div class=\"metric\">\n                <span>Records Processed:</span>\n                <span id=\"speed-count\">0</span>\n            </div>\n            <div class=\"metric\">\n                <span>Average Speed Rating:</span>\n                <span id=\"avg-speed-rating\">0.0</span>\n            </div>\n            <button class=\"btn\" onclick=\"calculateSpeedRatings()\">Calculate Speed Ratings</button>\n            <button class=\"btn btn-secondary\" onclick=\"viewSpeedRatings()\">View Results</button>\n            \n            <div class=\"progress-bar\" id=\"speed-progress-container\" style=\"display: none;\">\n                <div class=\"progress-fill\" id=\"speed-progress\" style=\"width: 0%;\"></div>\n            </div>\n        </div>\n        \n        <!-- Power Ratings Panel -->\n        <div class=\"panel metrics-panel\">\n            <h3>💪 Power Ratings Calculator</h3>\n            <div class=\"metric\">\n                <span>Status:</span>\n                <span id=\"power-status\" class=\"status-yellow\">Ready</span>\n            </div>\n            <div class=\"metric\">\n                <span>Records Processed:</span>\n                <span id=\"power-count\">0</span>\n            </div>\n            <div class=\"metric\">\n                <span>Average Power Rating:</span>\n                <span id=\"avg-power-rating\">0.0</span>\n            </div>\n            <button class=\"btn\" onclick=\"calculatePowerRatings()\">Calculate Power Ratings</button>\n            <button class=\"btn btn-secondary\" onclick=\"viewPowerRatings()\">View Results</button>\n            \n            <div class=\"progress-bar\" id=\"power-progress-container\" style=\"display: none;\">\n                <div class=\"progress-fill\" id=\"power-progress\" style=\"width: 0%;\"></div>\n            </div>\n        </div>\n        \n        <!-- Monte Carlo Panel -->\n        <div class=\"panel metrics-panel\">\n            <h3>🎲 Monte Carlo Simulation</h3>\n            <div class=\"metric\">\n                <span>Status:</span>\n                <span id=\"monte-carlo-status\" class=\"status-yellow\">Ready</span>\n            </div>\n            <div class=\"metric\">\n                <span>Simulations Run:</span>\n                <span id=\"monte-carlo-count\">0</span>\n            </div>\n            <div class=\"metric\">\n                <span>Simulation Count:</span>\n                <span id=\"simulation-count\">10,000</span>\n            </div>\n            <button class=\"btn\" onclick=\"runMonteCarloSimulation()\">Run Monte Carlo</button>\n            <button class=\"btn btn-secondary\" onclick=\"viewMonteCarloResults()\">View Results</button>\n            \n            <div class=\"progress-bar\" id=\"monte-carlo-progress-container\" style=\"display: none;\">\n                <div class=\"progress-fill\" id=\"monte-carlo-progress\" style=\"width: 0%;\"></div>\n            </div>\n        </div>\n        \n        <!-- All Metrics Control Panel -->\n        <div class=\"panel wide metrics-panel\">\n            <h3>🚀 Comprehensive Metrics Calculator</h3>\n            <div class=\"metrics-grid\">\n                <div class=\"metrics-card\">\n                    <h4>Batch Processing</h4>\n                    <div class=\"metric\">\n                        <span>Total Progress:</span>\n                        <span id=\"total-progress\">0%</span>\n                    </div>\n                    <div class=\"progress-bar\" id=\"total-progress-container\" style=\"display: none;\">\n                        <div class=\"progress-fill\" id=\"total-progress-bar\" style=\"width: 0%;\"></div>\n                    </div>\n                    <button class=\"btn\" onclick=\"calculateAllMetrics()\">Calculate All Metrics</button>\n                    <button class=\"btn btn-secondary\" onclick=\"resetAllMetrics()\">Reset All</button>\n                </div>\n                <div class=\"metrics-card\">\n                    <h4>Performance Stats</h4>\n                    <div class=\"metric\">\n                        <span>Processing Speed:</span>\n                        <span id=\"processing-speed\">0 records/min</span>\n                    </div>\n                    <div class=\"metric\">\n                        <span>Estimated Time:</span>\n                        <span id=\"estimated-time\">Unknown</span>\n                    </div>\n                    <div class=\"metric\">\n                        <span>Database Size:</span>\n                        <span id=\"database-size\">0 MB</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Configuration Panel -->\n        <div class=\"panel\">\n            <h3>⚙️ Configuration</h3>\n            <div class=\"config-item\">\n                <span>Speed Ratings Enabled:</span>\n                <span id=\"config-speed-enabled\" class=\"status-green\">●</span>\n            </div>\n            <div class=\"config-item\">\n                <span>Power Ratings Enabled:</span>\n                <span id=\"config-power-enabled\" class=\"status-green\">●</span>\n            </div>\n            <div class=\"config-item\">\n                <span>Monte Carlo Enabled:</span>\n                <span id=\"config-monte-carlo-enabled\" class=\"status-green\">●</span>\n            </div>\n            <div class=\"config-item\">\n                <span>Monte Carlo Simulations:</span>\n                <span id=\"config-mc-simulations\">10,000</span>\n            </div>\n            <button class=\"btn\" onclick=\"refreshConfig()\">Refresh Config</button>\n            <button class=\"btn btn-secondary\" onclick=\"validateDatabase()\">Validate Database</button>\n        </div>\n        \n        <!-- Real-time Logs Panel -->\n        <div class=\"panel full\">\n            <h3>📝 Real-time Processing Logs</h3>\n            <div class=\"log-area\" id=\"metrics-log-output\">\n                <div>[INFO] Advanced Metrics Center initialized</div>\n                <div>[INFO] Docker Advanced Metrics Populator ready</div>\n                <div>[CONFIG] Speed Ratings: ENABLED | Power Ratings: ENABLED | Monte Carlo: ENABLED</div>\n                <div>[DATABASE] Connected to advanced_racing_metrics_db</div>\n                <div>[READY] All metrics engines ready for calculation</div>\n            </div>\n            <div style=\"margin-top: 10px;\">\n                <button class=\"btn\" onclick=\"clearLogs()\">Clear Logs</button>\n                <button class=\"btn btn-secondary\" onclick=\"exportLogs()\">Export Logs</button>\n                <button class=\"btn btn-secondary\" onclick=\"showDebugMode()\">Debug Mode</button>\n            </div>\n        </div>\n    </div>\n    \n    <script>\n        let metricsInProgress = false;\n        \n        function updateMetricsStatus() {\n            fetch('/metrics/status')\n                .then(response => response.json())\n                .then(data => {\n                    // Update overview stats\n                    document.getElementById('total-speed-ratings').textContent = data.speed_ratings || 0;\n                    document.getElementById('total-power-ratings').textContent = data.power_ratings || 0;\n                    document.getElementById('total-monte-carlo').textContent = data.monte_carlo || 0;\n                    document.getElementById('total-records').textContent = data.total_records || 0;\n                    document.getElementById('last-update-time').textContent = data.last_update || 'Never';\n                    \n                    // Update individual metric counts\n                    document.getElementById('speed-count').textContent = data.speed_ratings || 0;\n                    document.getElementById('power-count').textContent = data.power_ratings || 0;\n                    document.getElementById('monte-carlo-count').textContent = data.monte_carlo || 0;\n                    \n                    // Update averages if available\n                    document.getElementById('avg-speed-rating').textContent = (data.avg_speed_rating || 0).toFixed(2);\n                    document.getElementById('avg-power-rating').textContent = (data.avg_power_rating || 0).toFixed(2);\n                    \n                    // Update configuration\n                    document.getElementById('config-speed-enabled').className = data.config?.speed_enabled ? 'status-green' : 'status-red';\n                    document.getElementById('config-power-enabled').className = data.config?.power_enabled ? 'status-green' : 'status-red';\n                    document.getElementById('config-monte-carlo-enabled').className = data.config?.monte_carlo_enabled ? 'status-green' : 'status-red';\n                    document.getElementById('config-mc-simulations').textContent = (data.config?.monte_carlo_simulations || 10000).toLocaleString();\n                    document.getElementById('simulation-count').textContent = (data.config?.monte_carlo_simulations || 10000).toLocaleString();\n                    \n                    // Update performance stats\n                    document.getElementById('processing-speed').textContent = (data.processing_speed || 0) + ' records/min';\n                    document.getElementById('estimated-time').textContent = data.estimated_time || 'Unknown';\n                    document.getElementById('database-size').textContent = (data.database_size || 0) + ' MB';\n                })\n                .catch(error => {\n                    console.error('Metrics status update failed:', error);\n                    addLog('[ERROR] Failed to update metrics status: ' + error.message);\n                });\n        }\n        \n        function calculateSpeedRatings() {\n            if (metricsInProgress) {\n                addLog('[WARNING] Metrics calculation already in progress');\n                return;\n            }\n            \n            showProgress('speed');\n            document.getElementById('speed-status').textContent = 'Calculating...';\n            document.getElementById('speed-status').className = 'status-yellow';\n            \n            addLog('[SPEED] Starting speed ratings calculation...');\n            \n            fetch('/c2/advanced-metrics/speed-ratings', { method: 'POST' })\n                .then(response => response.json())\n                .then(data => {\n                    if (data.success) {\n                        addLog('[SPEED] ✅ Speed ratings calculation completed: ' + (data.count || 0) + ' records');\n                        document.getElementById('speed-status').textContent = 'Complete';\n                        document.getElementById('speed-status').className = 'status-green';\n                        updateProgress('speed', 100);\n                        setTimeout(() => hideProgress('speed'), 2000);\n                    } else {\n                        addLog('[SPEED] ❌ Speed ratings calculation failed: ' + data.error);\n                        document.getElementById('speed-status').textContent = 'Failed';\n                        document.getElementById('speed-status').className = 'status-red';\n                        hideProgress('speed');\n                    }\n                })\n                .catch(error => {\n                    addLog('[SPEED] ❌ Error during speed ratings calculation: ' + error.message);\n                    document.getElementById('speed-status').textContent = 'Error';\n                    document.getElementById('speed-status').className = 'status-red';\n                    hideProgress('speed');\n                });\n        }\n        \n        function calculatePowerRatings() {\n            if (metricsInProgress) {\n                addLog('[WARNING] Metrics calculation already in progress');\n                return;\n            }\n            \n            showProgress('power');\n            document.getElementById('power-status').textContent = 'Calculating...';\n            document.getElementById('power-status').className = 'status-yellow';\n            \n            addLog('[POWER] Starting power ratings calculation...');\n            \n            fetch('/c2/advanced-metrics/power-ratings', { method: 'POST' })\n                .then(response => response.json())\n                .then(data => {\n                    if (data.success) {\n                        addLog('[POWER] ✅ Power ratings calculation completed: ' + (data.count || 0) + ' records');\n                        document.getElementById('power-status').textContent = 'Complete';\n                        document.getElementById('power-status').className = 'status-green';\n                        updateProgress('power', 100);\n                        setTimeout(() => hideProgress('power'), 2000);\n                    } else {\n                        addLog('[POWER] ❌ Power ratings calculation failed: ' + data.error);\n                        document.getElementById('power-status').textContent = 'Failed';\n                        document.getElementById('power-status').className = 'status-red';\n                        hideProgress('power');\n                    }\n                })\n                .catch(error => {\n                    addLog('[POWER] ❌ Error during power ratings calculation: ' + error.message);\n                    document.getElementById('power-status').textContent = 'Error';\n                    document.getElementById('power-status').className = 'status-red';\n                    hideProgress('power');\n                });\n        }\n        \n        function runMonteCarloSimulation() {\n            if (metricsInProgress) {\n                addLog('[WARNING] Metrics calculation already in progress');\n                return;\n            }\n            \n            showProgress('monte-carlo');\n            document.getElementById('monte-carlo-status').textContent = 'Running...';\n            document.getElementById('monte-carlo-status').className = 'status-yellow';\n            \n            addLog('[MONTE CARLO] Starting Monte Carlo simulation...');\n            \n            fetch('/c2/advanced-metrics/monte-carlo', { method: 'POST' })\n                .then(response => response.json())\n                .then(data => {\n                    if (data.success) {\n                        addLog('[MONTE CARLO] ✅ Monte Carlo simulation completed: ' + (data.simulations || 0) + ' simulations');\n                        document.getElementById('monte-carlo-status').textContent = 'Complete';\n                        document.getElementById('monte-carlo-status').className = 'status-green';\n                        updateProgress('monte-carlo', 100);\n                        setTimeout(() => hideProgress('monte-carlo'), 2000);\n                    } else {\n                        addLog('[MONTE CARLO] ❌ Monte Carlo simulation failed: ' + data.error);\n                        document.getElementById('monte-carlo-status').textContent = 'Failed';\n                        document.getElementById('monte-carlo-status').className = 'status-red';\n                        hideProgress('monte-carlo');\n                    }\n                })\n                .catch(error => {\n                    addLog('[MONTE CARLO] ❌ Error during Monte Carlo simulation: ' + error.message);\n                    document.getElementById('monte-carlo-status').textContent = 'Error';\n                    document.getElementById('monte-carlo-status').className = 'status-red';\n                    hideProgress('monte-carlo');\n                });\n        }\n        \n        function calculateAllMetrics() {\n            if (metricsInProgress) {\n                addLog('[WARNING] Metrics calculation already in progress');\n                return;\n            }\n            \n            metricsInProgress = true;\n            showProgress('total');\n            \n            // Update all status indicators\n            document.getElementById('speed-status').textContent = 'Queued';\n            document.getElementById('power-status').textContent = 'Queued';\n            document.getElementById('monte-carlo-status').textContent = 'Queued';\n            \n            addLog('[ALL METRICS] Starting comprehensive metrics calculation...');\n            \n            fetch('/c2/advanced-metrics/calculate-all', { method: 'POST' })\n                .then(response => response.json())\n                .then(data => {\n                    if (data.success) {\n                        addLog('[ALL METRICS] ✅ All metrics calculation completed successfully');\n                        addLog('[RESULTS] ' + data.message);\n                        \n                        // Update all status to complete\n                        document.getElementById('speed-status').textContent = 'Complete';\n                        document.getElementById('speed-status').className = 'status-green';\n                        document.getElementById('power-status').textContent = 'Complete';\n                        document.getElementById('power-status').className = 'status-green';\n                        document.getElementById('monte-carlo-status').textContent = 'Complete';\n                        document.getElementById('monte-carlo-status').className = 'status-green';\n                        \n                        updateProgress('total', 100);\n                        setTimeout(() => hideProgress('total'), 3000);\n                        \n                        // Refresh status\n                        setTimeout(updateMetricsStatus, 1000);\n                    } else {\n                        addLog('[ALL METRICS] ❌ Comprehensive metrics calculation failed: ' + data.error);\n                        \n                        // Reset status indicators\n                        document.getElementById('speed-status').textContent = 'Ready';\n                        document.getElementById('speed-status').className = 'status-yellow';\n                        document.getElementById('power-status').textContent = 'Ready';\n                        document.getElementById('power-status').className = 'status-yellow';\n                        document.getElementById('monte-carlo-status').textContent = 'Ready';\n                        document.getElementById('monte-carlo-status').className = 'status-yellow';\n                        \n                        hideProgress('total');\n                    }\n                    metricsInProgress = false;\n                })\n                .catch(error => {\n                    addLog('[ALL METRICS] ❌ Error during comprehensive metrics calculation: ' + error.message);\n                    metricsInProgress = false;\n                    hideProgress('total');\n                });\n        }\n        \n        function showProgress(type) {\n            const container = document.getElementById(type + '-progress-container');\n            if (container) {\n                container.style.display = 'block';\n                \n                // Simulate progress\n                let progress = 0;\n                const interval = setInterval(() => {\n                    progress += Math.random() * 10;\n                    if (progress >= 90) {\n                        progress = 90;\n                        clearInterval(interval);\n                    }\n                    updateProgress(type, progress);\n                }, 200);\n            }\n        }\n        \n        function updateProgress(type, percentage) {\n            const progressBar = document.getElementById(type + '-progress');\n            if (progressBar) {\n                progressBar.style.width = percentage + '%';\n            }\n            \n            if (type === 'total') {\n                document.getElementById('total-progress').textContent = Math.round(percentage) + '%';\n            }\n        }\n        \n        function hideProgress(type) {\n            const container = document.getElementById(type + '-progress-container');\n            if (container) {\n                setTimeout(() => {\n                    container.style.display = 'none';\n                    updateProgress(type, 0);\n                }, 1000);\n            }\n        }\n        \n        function refreshConfig() {\n            addLog('[CONFIG] Refreshing advanced metrics configuration...');\n            fetch('/c2/advanced-metrics/config')\n                .then(response => response.json())\n                .then(data => {\n                    addLog('[CONFIG] ✅ Configuration refreshed successfully');\n                    updateMetricsStatus();\n                })\n                .catch(error => {\n                    addLog('[CONFIG] ❌ Failed to refresh configuration: ' + error.message);\n                });\n        }\n        \n        function validateDatabase() {\n            addLog('[DATABASE] Validating advanced metrics database...');\n            fetch('/c2/advanced-metrics/validate-db', { method: 'POST' })\n                .then(response => response.json())\n                .then(data => {\n                    if (data.valid) {\n                        addLog('[DATABASE] ✅ Database validation passed');\n                    } else {\n                        addLog('[DATABASE] ❌ Database validation failed: ' + data.error);\n                    }\n                })\n                .catch(error => {\n                    addLog('[DATABASE] ❌ Database validation error: ' + error.message);\n                });\n        }\n        \n        function addLog(message) {\n            const logArea = document.getElementById('metrics-log-output');\n            const timestamp = new Date().toLocaleTimeString();\n            const logEntry = document.createElement('div');\n            logEntry.textContent = '[' + timestamp + '] ' + message;\n            logArea.appendChild(logEntry);\n            logArea.scrollTop = logArea.scrollHeight;\n            \n            // Keep only last 50 log entries\n            while (logArea.children.length > 50) {\n                logArea.removeChild(logArea.firstChild);\n            }\n        }\n        \n        function clearLogs() {\n            document.getElementById('metrics-log-output').innerHTML = '';\n            addLog('[INFO] Log area cleared');\n        }\n        \n        function resetAllMetrics() {\n            if (confirm('Are you sure you want to reset all metrics calculations?')) {\n                addLog('[RESET] Resetting all metrics calculations...');\n                \n                // Reset all status indicators\n                document.getElementById('speed-status').textContent = 'Ready';\n                document.getElementById('speed-status').className = 'status-yellow';\n                document.getElementById('power-status').textContent = 'Ready';\n                document.getElementById('power-status').className = 'status-yellow';\n                document.getElementById('monte-carlo-status').textContent = 'Ready';\n                document.getElementById('monte-carlo-status').className = 'status-yellow';\n                \n                metricsInProgress = false;\n                addLog('[RESET] All metrics calculators reset to ready state');\n            }\n        }\n        \n        function viewSpeedRatings() {\n            addLog('[VIEW] Opening speed ratings results...');\n            // This would typically open a detailed view or export results\n            alert('Speed Ratings view functionality would be implemented here');\n        }\n        \n        function viewPowerRatings() {\n            addLog('[VIEW] Opening power ratings results...');\n            alert('Power Ratings view functionality would be implemented here');\n        }\n        \n        function viewMonteCarloResults() {\n            addLog('[VIEW] Opening Monte Carlo simulation results...');\n            alert('Monte Carlo Results view functionality would be implemented here');\n        }\n        \n        function showDebugMode() {\n            addLog('[DEBUG] Debug mode enabled');\n            addLog('[DEBUG] Docker container: horse_racing_data_pipeline_clean');\n            addLog('[DEBUG] Metrics script: /app/docker_advanced_metrics_populator.py');\n            addLog('[DEBUG] Database: advanced_racing_metrics_db');\n            addLog('[DEBUG] Environment variables loaded');\n        }\n        \n        function exportLogs() {\n            const logs = document.getElementById('metrics-log-output').innerText;\n            const blob = new Blob([logs], { type: 'text/plain' });\n            const url = URL.createObjectURL(blob);\n            const a = document.createElement('a');\n            a.href = url;\n            a.download = 'advanced-metrics-logs-' + new Date().toISOString().slice(0,10) + '.txt';\n            a.click();\n            URL.revokeObjectURL(url);\n            addLog('[EXPORT] Logs exported successfully');\n        }\n        \n        // Auto-refresh metrics status every 30 seconds\n        setInterval(updateMetricsStatus, 30000);\n        \n        // Initialize dashboard\n        function initializeMetricsDashboard() {\n            addLog('[INIT] Advanced Metrics Dashboard initializing...');\n            updateMetricsStatus();\n            addLog('[INIT] Dashboard ready for metrics calculation');\n        }\n        \n        // Initialize on page load\n        initializeMetricsDashboard();\n    </script>\n</body>\n</html>",
