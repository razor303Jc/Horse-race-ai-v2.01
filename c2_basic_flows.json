  {
    "id": "c2_dashboard_template",
    "type": "template",
    "z": "c2_main_tab",
    "name": "C2 Dashboard HTML",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "mustache",
    "template": "<!DOCTYPE html>\n<html>\n<head>\n    <title>🎯 Horse Racing AI - C2 Command Center</title>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <style>\n        body {\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n            margin: 0;\n            padding: 20px;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n        }\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            background: rgba(0,0,0,0.3);\n            padding: 30px;\n            border-radius: 15px;\n            backdrop-filter: blur(10px);\n        }\n        .header {\n            text-align: center;\n            margin-bottom: 40px;\n        }\n        .status-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 20px;\n            margin-bottom: 30px;\n        }\n        .status-card {\n            background: rgba(255,255,255,0.1);\n            padding: 20px;\n            border-radius: 10px;\n            border: 1px solid rgba(255,255,255,0.2);\n        }\n        .control-buttons {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 15px;\n            margin-bottom: 30px;\n        }\n        .btn {\n            padding: 12px 20px;\n            border: none;\n            border-radius: 8px;\n            cursor: pointer;\n            font-size: 14px;\n            font-weight: bold;\n            transition: all 0.3s ease;\n        }\n        .btn-primary { background: #4CAF50; color: white; }\n        .btn-warning { background: #FF9800; color: white; }\n        .btn-danger { background: #f44336; color: white; }\n        .btn-info { background: #2196F3; color: white; }\n        .btn:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.3); }\n        .log-area {\n            background: rgba(0,0,0,0.5);\n            border: 1px solid rgba(255,255,255,0.3);\n            border-radius: 8px;\n            padding: 15px;\n            height: 300px;\n            overflow-y: auto;\n            font-family: 'Courier New', monospace;\n            font-size: 12px;\n            line-height: 1.4;\n        }\n        .log-entry {\n            margin-bottom: 5px;\n            padding: 2px 0;\n        }\n        .log-success { color: #4CAF50; }\n        .log-error { color: #f44336; }\n        .log-warning { color: #FF9800; }\n        .log-info { color: #2196F3; }\n        .status-indicator {\n            display: inline-block;\n            width: 12px;\n            height: 12px;\n            border-radius: 50%;\n            margin-right: 8px;\n        }\n        .status-online { background: #4CAF50; }\n        .status-offline { background: #f44336; }\n        .status-warning { background: #FF9800; }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"header\">\n            <h1>🎯 Horse Racing AI - Command & Control Center</h1>\n            <p>Real-time system monitoring and automation control</p>\n        </div>\n        \n        <div class=\"status-grid\">\n            <div class=\"status-card\">\n                <h3><span class=\"status-indicator status-online\"></span>System Status</h3>\n                <p id=\"system-status\">All systems operational</p>\n                <small>Last updated: <span id=\"last-update\">--</span></small>\n            </div>\n            <div class=\"status-card\">\n                <h3><span class=\"status-indicator status-online\"></span>Database</h3>\n                <p id=\"database-status\">PostgreSQL connected</p>\n                <small>Active connections: <span id=\"db-connections\">--</span></small>\n            </div>\n            <div class=\"status-card\">\n                <h3><span class=\"status-indicator status-online\"></span>Data Pipeline</h3>\n                <p id=\"pipeline-status\">Ready for processing</p>\n                <small>Last run: <span id=\"last-pipeline-run\">--</span></small>\n            </div>\n            <div class=\"status-card\">\n                <h3><span class=\"status-indicator status-online\"></span>Node-RED</h3>\n                <p id=\"nodered-status\">C2 flows active</p>\n                <small>Endpoints: <span id=\"active-endpoints\">5 active</span></small>\n            </div>\n        </div>\n        \n        <div class=\"control-buttons\">\n            <button class=\"btn btn-primary\" onclick=\"triggerProcessing()\">🚀 Start Processing</button>\n            <button class=\"btn btn-info\" onclick=\"runHealthCheck()\">🔍 Health Check</button>\n            <button class=\"btn btn-info\" onclick=\"testNTFY()\">📱 Test NTFY</button>\n            <button class=\"btn btn-warning\" onclick=\"backupDatabase()\">💾 Backup DB</button>\n            <button class=\"btn btn-warning\" onclick=\"restartServices()\">🔄 Restart Services</button>\n            <button class=\"btn btn-danger\" onclick=\"emergencyStop()\">🛑 Emergency Stop</button>\n        </div>\n        \n        <div>\n            <h3>📋 System Log</h3>\n            <div class=\"log-area\" id=\"log-area\">\n                <div class=\"log-entry log-info\">[INFO] C2 Dashboard initialized</div>\n                <div class=\"log-entry log-success\">[SUCCESS] Connection to Node-RED established</div>\n                <div class=\"log-entry log-info\">[INFO] Monitoring systems...</div>\n            </div>\n        </div>\n    </div>\n    \n    <script>\n        function addLogEntry(message, type = 'info') {\n            const logArea = document.getElementById('log-area');\n            const timestamp = new Date().toLocaleTimeString();\n            const entry = document.createElement('div');\n            entry.className = `log-entry log-${type.toLowerCase()}`;\n            entry.textContent = `[${timestamp}] [${type.toUpperCase()}] ${message}`;\n            logArea.appendChild(entry);\n            logArea.scrollTop = logArea.scrollHeight;\n        }\n        \n        function updateLastUpdate() {\n            document.getElementById('last-update').textContent = new Date().toLocaleTimeString();\n        }\n        \n        function triggerProcessing() {\n            addLogEntry('Triggering data processing pipeline...', 'info');\n            fetch('/trigger-processing', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify({ action: 'process_today', source: 'c2_dashboard' })\n            })\n            .then(response => response.json())\n            .then(data => {\n                addLogEntry('Processing pipeline started successfully', 'success');\n                updateLastUpdate();\n            })\n            .catch(error => {\n                addLogEntry(`Processing failed: ${error.message}`, 'error');\n            });\n        }\n        \n        function runHealthCheck() {\n            addLogEntry('Running comprehensive health check...', 'info');\n            fetch('/health-check')\n            .then(response => response.json())\n            .then(data => {\n                addLogEntry('Health check completed successfully', 'success');\n                updateSystemStatus(data);\n            })\n            .catch(error => {\n                addLogEntry(`Health check failed: ${error.message}`, 'error');\n            });\n        }\n        \n        function testNTFY() {\n            addLogEntry('Testing NTFY notification system...', 'info');\n            fetch('/send-ntfy', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify({\n                    title: 'C2 Test Notification',\n                    message: 'This is a test notification from the Command & Control dashboard!',\n                    topic: 'horserace-system',\n                    tags: 'test,c2,dashboard',\n                    priority: 'default'\n                })\n            })\n            .then(response => response.json())\n            .then(data => {\n                addLogEntry('NTFY test notification sent successfully', 'success');\n            })\n            .catch(error => {\n                addLogEntry(`NTFY test failed: ${error.message}`, 'error');\n            });\n        }\n        \n        function backupDatabase() {\n            if (confirm('Start database backup? This may take a few minutes.')) {\n                addLogEntry('Starting database backup...', 'warning');\n                fetch('/backup-database', {\n                    method: 'POST'\n                })\n                .then(response => response.json())\n                .then(data => {\n                    addLogEntry('Database backup completed successfully', 'success');\n                })\n                .catch(error => {\n                    addLogEntry(`Backup failed: ${error.message}`, 'error');\n                });\n            }\n        }\n        \n        function restartServices() {\n            if (confirm('Are you sure you want to restart all services? This may cause temporary downtime.')) {\n                addLogEntry('Restarting services...', 'warning');\n                fetch('/restart-services', {\n                    method: 'POST'\n                })\n                .then(response => response.json())\n                .then(data => {\n                    addLogEntry('Service restart completed', 'success');\n                })\n                .catch(error => {\n                    addLogEntry(`Restart failed: ${error.message}`, 'error');\n                });\n            }\n        }\n        \n        function emergencyStop() {\n            if (confirm('EMERGENCY STOP: This will halt all automated processes. Are you sure?')) {\n                addLogEntry('EMERGENCY STOP ACTIVATED', 'error');\n                fetch('/emergency-stop', {\n                    method: 'POST'\n                })\n                .then(response => response.json())\n                .then(data => {\n                    addLogEntry('All processes stopped', 'warning');\n                })\n                .catch(error => {\n                    addLogEntry(`Emergency stop error: ${error.message}`, 'error');\n                });\n            }\n        }\n        \n        function updateSystemStatus(data) {\n            updateLastUpdate();\n            addLogEntry('System status updated', 'info');\n        }\n        \n        // Auto-refresh every 30 seconds\n        setInterval(() => {\n            updateLastUpdate();\n            addLogEntry('Auto-refresh: Status updated', 'info');\n        }, 30000);\n        \n        // Initial load\n        updateLastUpdate();\n        addLogEntry('C2 Dashboard fully loaded and operational', 'success');\n    </script>\n</body>\n</html>",
    "x": 360,
    "y": 80,
    "wires": [["c2_dashboard_response"]]
  },
