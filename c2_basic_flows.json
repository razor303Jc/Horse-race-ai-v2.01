  {
    "id": "ntfy_notification",
    "type": "function",
    "z": "c2_main_tab",
    "name": "NTFY Handler",
    "func": "// Handle NTFY notifications\nconst title = msg.payload.title || 'System Notification';\nconst message = msg.payload.message || 'No message provided';\nconst topic = msg.payload.topic || 'horserace-system';\nconst tags = msg.payload.tags || 'system';\nconst priority = msg.payload.priority || 'default';\n\n// Log the notification\nconsole.log(`[NTFY] ${title}: ${message}`);\n\n// For now, simulate successful NTFY sending\n// In production, this would make an actual HTTP request to NTFY server\nconst response = {\n    status: 'success',\n    message: 'Notification sent successfully',\n    timestamp: new Date().toISOString(),\n    notification: {\n        title: title,\n        message: message,\n        topic: topic,\n        tags: tags,\n        priority: priority\n    }\n};\n\nmsg.payload = response;\nmsg.statusCode = 200;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
