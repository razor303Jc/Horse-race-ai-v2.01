  {
    "id": "trigger_processing_logic",
    "type": "function",
    "z": "c2_main_tab",
    "name": "Trigger Processing Logic",
    "func": "// Handle processing trigger requests\nconst timestamp = new Date().toISOString();\nconst action = msg.payload.action || 'unknown';\nconst source = msg.payload.source || 'api';\n\n// Log the processing request\nconsole.log(`[${timestamp}] Processing triggered: ${action} from ${source}`);\n\n// Simulate processing trigger\nconst response = {\n    status: 'success',\n    message: 'Processing pipeline triggered successfully',\n    timestamp: timestamp,\n    action: action,\n    source: source,\n    job_id: 'job_' + Date.now()\n};\n\nmsg.payload = response;\nmsg.statusCode = 200;\n\n// Send notification\nmsg.ntfy = {\n    title: '🚀 Processing Started',\n    message: `Data processing pipeline triggered from ${source}`,\n    topic: 'horserace-processing',\n    tags: 'processing,started',\n    priority: 'default'\n};\n\nreturn [msg, {payload: msg.ntfy}];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 240,
    "wires": [["trigger_processing_response"], ["ntfy_notification"]]
  },
