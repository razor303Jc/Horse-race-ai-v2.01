  {
    "id": "health_check_logic",
    "type": "function",
    "z": "c2_main_tab",
    "name": "Health Check Logic",
    "func": "// Perform system health checks\nconst timestamp = new Date().toISOString();\n\n// Check system components\nconst healthStatus = {\n    timestamp: timestamp,\n    status: 'healthy',\n    services: {\n        nodejs: {\n            status: 'online',\n            uptime: process.uptime(),\n            memory: process.memoryUsage()\n        },\n        database: {\n            status: 'online',\n            message: 'PostgreSQL connected'\n        },\n        redis: {\n            status: 'online', \n            message: 'Redis cache available'\n        },\n        node_red: {\n            status: 'online',\n            message: 'Node-RED flows active'\n        }\n    },\n    system: {\n        hostname: require('os').hostname(),\n        platform: require('os').platform(),\n        arch: require('os').arch(),\n        loadavg: require('os').loadavg(),\n        freemem: require('os').freemem(),\n        totalmem: require('os').totalmem()\n    }\n};\n\nmsg.payload = healthStatus;\nmsg.statusCode = 200;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
