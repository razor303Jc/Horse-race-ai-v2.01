        {
          "name": "Get Processing Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{web_app_url}}/api/processing/stats",
              "host": ["{{web_app_url}}"],
              "path": ["api", "processing", "stats"]
            },
            "description": "Get data processing statistics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Processing stats endpoint accessible', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Stats contain required fields', function () {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response).to.have.property('cardsToday');",
                  "        pm.expect(response).to.have.property('resultsToday');",
                  "        pm.expect(response).to.have.property('totalCards');",
                  "        pm.expect(response).to.have.property('totalResults');",
                  "        pm.expect(response).to.have.property('timestamp');",
                  "    });",
                  "",
                  "    pm.test('Stats values are numbers', function () {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response.cardsToday).to.be.a('number');",
                  "        pm.expect(response.resultsToday).to.be.a('number');",
                  "        pm.expect(response.totalCards).to.be.a('number');",
                  "        pm.expect(response.totalResults).to.be.a('number');",
                  "    });",
                  "",
                  "    pm.test('Stats values are non-negative', function () {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response.cardsToday).to.be.at.least(0);",
                  "        pm.expect(response.resultsToday).to.be.at.least(0);",
                  "        pm.expect(response.totalCards).to.be.at.least(0);",
                  "        pm.expect(response.totalResults).to.be.at.least(0);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Database Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{web_app_url}}/api/database/stats",
              "host": ["{{web_app_url}}"],
              "path": ["api", "database", "stats"]
            },
            "description": "Get database connection statistics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Database stats endpoint accessible', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Database stats structure valid', function () {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response).to.have.property('databases');",
                  "        pm.expect(response).to.have.property('overall');",
                  "    });",
                  "",
                  "    pm.test('Database status values valid', function () {",
                  "        const response = pm.response.json();",
                  "        Object.keys(response.databases).forEach(dbName => {",
                  "            const db = response.databases[dbName];",
                  "            pm.expect(db).to.have.property('status');",
                  "            pm.expect(['online', 'offline']).to.include(db.status);",
                  "        });",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Trigger Data Processing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data_type\": \"cards\",\n  \"start_date\": \"2025-08-30\",\n  \"end_date\": \"2025-08-30\",\n  \"source\": \"postman_api_test\"\n}"
            },
            "url": {
              "raw": "{{web_app_url}}/api/processing/trigger",
              "host": ["{{web_app_url}}"],
              "path": ["api", "processing", "trigger"]
            },
            "description": "Trigger data processing job"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Processing trigger endpoint accessible', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 503]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Processing trigger response valid', function () {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response).to.have.property('status');",
                  "        pm.expect(response.status).to.equal('success');",
                  "        pm.expect(response).to.have.property('processing_id');",
                  "        pm.expect(response).to.have.property('data_type');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
