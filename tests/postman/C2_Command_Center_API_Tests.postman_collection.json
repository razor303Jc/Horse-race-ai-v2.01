{
  "info": {
    "name": "🎯 C2 Command Center API Tests",
    "description": "Comprehensive API testing for Horse Racing AI C2 Command Center",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "horse-racing-c2-secure-key-2025",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "node_red_url",
      "value": "http://localhost:1881",
      "type": "string"
    },
    {
      "key": "web_app_url", 
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "horse-racing-c2-secure-key-2025",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🏠 C2 Dashboard Tests",
      "item": [
        {
          "name": "Get C2 Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node_red_url}}/c2-dashboard",
              "host": ["{{node_red_url}}"],
              "path": ["c2-dashboard"]
            },
            "description": "Test C2 dashboard accessibility and content"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Dashboard loads successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Contains C2 Command Center title', function () {",
                  "    pm.expect(pm.response.text()).to.include('C2 Command Center');",
                  "});",
                  "",
                  "pm.test('Bootstrap CSS loaded', function () {",
                  "    pm.expect(pm.response.text()).to.include('bootstrap');",
                  "});",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Test UI Redirect",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node_red_url}}/ui/",
              "host": ["{{node_red_url}}"],
              "path": ["ui", ""]
            },
            "description": "Test that /ui/ redirects properly"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('UI redirect works', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});",
                  "",
                  "pm.test('Contains dashboard content', function () {",
                  "    pm.expect(pm.response.text()).to.include('Command Center');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🐳 Container Management",
      "item": [
        {
          "name": "Get Container Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{node_red_url}}/containers/status",
              "host": ["{{node_red_url}}"],
              "path": ["containers", "status"]
            },
            "description": "Get status of all containers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Container status endpoint responds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains container data', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('containers');",
                  "    pm.expect(response).to.have.property('total');",
                  "    pm.expect(response).to.have.property('healthy');",
                  "});",
                  "",
                  "pm.test('Container array is valid', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.containers).to.be.an('array');",
                  "    pm.expect(response.total).to.be.a('number');",
                  "    pm.expect(response.healthy).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(15000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Docker Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{node_red_url}}/docker/stats",
              "host": ["{{node_red_url}}"],
              "path": ["docker", "stats"]
            },
            "description": "Get Docker container statistics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Docker stats endpoint responds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Stats contain timestamp', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('timestamp');",
                  "});",
                  "",
                  "pm.test('Stats contain container data', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('containers');",
                  "    pm.expect(response.containers).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(20000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Container Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key", 
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{node_red_url}}/docker/logs/horse_racing_web_app_clean?lines=10",
              "host": ["{{node_red_url}}"],
              "path": ["docker", "logs", "horse_racing_web_app_clean"],
              "query": [
                {
                  "key": "lines",
                  "value": "10"
                }
              ]
            },
            "description": "Get container logs with line limit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Container logs endpoint responds', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404, 500]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Logs contain expected data', function () {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response).to.have.property('logs');",
                  "        pm.expect(response).to.have.property('container');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "📢 NTFY Integration",
      "item": [
        {
          "name": "Send NTFY Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Test notification from Postman API test\",\n  \"priority\": \"3\",\n  \"topic\": \"horse-racing-ai\",\n  \"title\": \"Postman Test\"\n}"
            },
            "url": {
              "raw": "{{node_red_url}}/send-ntfy",
              "host": ["{{node_red_url}}"],
              "path": ["send-ntfy"]
            },
            "description": "Send test notification via NTFY"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('NTFY send endpoint responds', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 500, 503]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Response contains status', function () {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response).to.have.property('status');",
                  "    });",
                  "}",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(10000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
