# Optimized Dockerfile for Pipeline Management Service
# Build time: ~3 minutes (vs 15+ minutes with full requirements)

FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies (minimal)
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy optimized requirements
COPY requirements-pipeline-management-optimized.txt .

# Install Python dependencies (only what's needed)
RUN pip install --no-cache-dir -r requirements-pipeline-management-optimized.txt

# Copy pipeline management code
COPY docker/pipeline_management/ ./pipeline_management/
COPY config/ ./config/

# Create logs directory with proper permissions
RUN mkdir -p logs && chmod 777 logs

# Set Python path
ENV PYTHONPATH=/app:/app/pipeline_management

# Create non-root user for security
RUN adduser --disabled-password --gecos '' pipelineuser && \
    chown -R pipelineuser:pipelineuser /app
USER pipelineuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import pipeline_management.dynamic_pipeline_timing; print('OK')" || exit 1

# Default command
CMD ["python", "pipeline_management/simple_pipeline_manager.py"]
