    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "mustache",
    "template": "<!DOCTYPE html>\n<html>\n<head>\n    <meta http-equiv=\"refresh\" content=\"0; url=/c2\">\n    <title>Redirecting to C2 Command Center</title>\n</head>\n<body>\n    <h1>Redirecting to Horse Racing AI C2 Command Center...</h1>\n    <p>If you are not redirected automatically, <a href=\"/c2\">click here</a>.</p>\n</body>\n</html>",
    "output": "str",
    "x": 320,
    "y": 160,
    "wires": [["http-response-redirect"]]
  },
  {
