  {
    "id": "ntfy_response_handler",
    "type": "function",
    "z": "notifications_tab",
    "name": "NTFY Response Handler",
    "func": "// Handle NTFY response\nif (msg.statusCode === 200) {\n    msg.payload = {\n        status: 'success',\n        message: 'Notification sent successfully',\n        ntfyResponse: msg.payload\n    };\n} else {\n    msg.payload = {\n        status: 'error',\n        message: 'Failed to send notification',\n        statusCode: msg.statusCode,\n        error: msg.payload\n    };\n}\n\nreturn msg;",
    "outputs": 1,
