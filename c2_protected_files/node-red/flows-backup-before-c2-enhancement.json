  {
    "id": "parse_processing_request",
    "type": "function",
    "z": "main_tab",
    "name": "Parse Processing Request",
    "func": "// Parse the processing request\nconst requestData = msg.payload;\nconst processingType = requestData.type || 'both';\nconst startDate = requestData.startDate;\nconst endDate = requestData.endDate;\n\n// Validate dates\nif (!startDate || !endDate) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: 'error',\n        message: 'startDate and endDate are required'\n    };\n    return msg;\n}\n\n// Prepare command\nmsg.command = `cd /home/jc/Documents/Horse-race-ai-v2.04 && python tools/node_red_data_processor.py --start-date ${startDate} --end-date ${endDate} --type ${processingType}`;\n\nmsg.payload = {\n    processing: true,\n    startDate: startDate,\n    endDate: endDate,\n    dataType: processingType,\n    command: msg.command,\n    source: 'web_dashboard'\n};\n\n// Send success response immediately\nmsg.res.json({\n    status: 'success',\n    message: 'Processing started',\n    request: {\n        type: processingType,\n        startDate: startDate,\n        endDate: endDate\n    }\n});\n\nnode.status({fill: \"yellow\", shape: \"dot\", text: `Processing ${processingType} ${startDate}-${endDate}`});\n\nreturn msg;",
