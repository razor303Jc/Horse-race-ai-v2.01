  {
    "id": "dashboard_template",
    "type": "template",
    "z": "main_tab",
    "name": "Dashboard HTML",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "mustache",
    "template": "<!DOCTYPE html>\n<html>\n<head>\n    <title>🐎 Horse Racing AI Dashboard</title>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n    <style>\n        .status-card { transition: transform 0.2s; }\n        .status-card:hover { transform: translateY(-2px); }\n        .status-online { color: #28a745; }\n        .status-offline { color: #dc3545; }\n        .btn-action { margin: 5px; }\n        .processing-log { height: 200px; overflow-y: auto; background: #f8f9fa; padding: 10px; border-radius: 5px; }\n    </style>\n</head>\n<body class=\"bg-light\">\n    <nav class=\"navbar navbar-dark bg-primary\">\n        <div class=\"container\">\n            <span class=\"navbar-brand\"><i class=\"fas fa-horse-head\"></i> Horse Racing AI Dashboard</span>\n            <span class=\"navbar-text\" id=\"lastUpdate\">Last Update: Never</span>\n        </div>\n    </nav>\n    \n    <div class=\"container-fluid mt-4\">\n        <div class=\"row\">\n            <!-- System Status -->\n            <div class=\"col-md-6 mb-4\">\n                <div class=\"card status-card\">\n                    <div class=\"card-header bg-primary text-white\">\n                        <i class=\"fas fa-heartbeat\"></i> System Status\n                    </div>\n                    <div class=\"card-body\">\n                        <div class=\"row text-center\">\n                            <div class=\"col-4\">\n                                <div id=\"databaseStatus\" class=\"status-offline\">\n                                    <i class=\"fas fa-database fa-2x\"></i>\n                                    <p class=\"mt-2\">Database<br><small>Offline</small></p>\n                                </div>\n                            </div>\n                            <div class=\"col-4\">\n                                <div id=\"apiStatus\" class=\"status-offline\">\n                                    <i class=\"fas fa-brain fa-2x\"></i>\n                                    <p class=\"mt-2\">APIs<br><small>Offline</small></p>\n                                </div>\n                            </div>\n                            <div class=\"col-4\">\n                                <div id=\"pipelineStatus\" class=\"status-offline\">\n                                    <i class=\"fas fa-cogs fa-2x\"></i>\n                                    <p class=\"mt-2\">Pipeline<br><small>Ready</small></p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- Processing Controls -->\n            <div class=\"col-md-6 mb-4\">\n                <div class=\"card status-card\">\n                    <div class=\"card-header bg-success text-white\">\n                        <i class=\"fas fa-play-circle\"></i> Quick Actions\n                    </div>\n                    <div class=\"card-body\">\n                        <button class=\"btn btn-primary btn-action\" onclick=\"processData('cards', 'today')\">\n                            <i class=\"fas fa-file-alt\"></i> Process Cards Today\n                        </button>\n                        <button class=\"btn btn-success btn-action\" onclick=\"processData('results', 'today')\">\n                            <i class=\"fas fa-chart-bar\"></i> Process Results Today\n                        </button>\n                        <button class=\"btn btn-info btn-action\" onclick=\"processData('both', 'today')\">\n                            <i class=\"fas fa-sync\"></i> Process Both Today\n                        </button>\n                        <button class=\"btn btn-warning btn-action\" onclick=\"runFullPipeline()\">\n                            <i class=\"fas fa-rocket\"></i> Full Pipeline\n                        </button>\n                        <button class=\"btn btn-outline-secondary btn-action\" onclick=\"startAPIs()\">\n                            <i class=\"fas fa-power-off\"></i> Start APIs\n                        </button>\n                        <button class=\"btn btn-outline-info btn-action\" onclick=\"testSystem()\">\n                            <i class=\"fas fa-stethoscope\"></i> Test System\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"row\">\n            <!-- Date Range Selection -->\n            <div class=\"col-md-4 mb-4\">\n                <div class=\"card\">\n                    <div class=\"card-header bg-info text-white\">\n                        <i class=\"fas fa-calendar-alt\"></i> Custom Processing\n                    </div>\n                    <div class=\"card-body\">\n                        <div class=\"mb-3\">\n                            <label class=\"form-label\">Start Date</label>\n                            <input type=\"date\" class=\"form-control\" id=\"startDate\">\n                        </div>\n                        <div class=\"mb-3\">\n                            <label class=\"form-label\">End Date</label>\n                            <input type=\"date\" class=\"form-control\" id=\"endDate\">\n                        </div>\n                        <div class=\"mb-3\">\n                            <label class=\"form-label\">Data Type</label>\n                            <select class=\"form-select\" id=\"dataType\">\n                                <option value=\"both\">Both Cards & Results</option>\n                                <option value=\"cards\">Cards Only</option>\n                                <option value=\"results\">Results Only</option>\n                            </select>\n                        </div>\n                        <button class=\"btn btn-primary w-100\" onclick=\"processCustomRange()\">\n                            <i class=\"fas fa-play\"></i> Process Custom Range\n                        </button>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- Processing Statistics -->\n            <div class=\"col-md-4 mb-4\">\n                <div class=\"card\">\n                    <div class=\"card-header bg-warning text-dark\">\n                        <i class=\"fas fa-chart-pie\"></i> Processing Stats\n                    </div>\n                    <div class=\"card-body\">\n                        <div class=\"row text-center\">\n                            <div class=\"col-6\">\n                                <h3 class=\"text-primary\" id=\"cardsCount\">0</h3>\n                                <p class=\"text-muted\">Cards Today</p>\n                            </div>\n                            <div class=\"col-6\">\n                                <h3 class=\"text-success\" id=\"resultsCount\">0</h3>\n                                <p class=\"text-muted\">Results Today</p>\n                            </div>\n                        </div>\n                        <hr>\n                        <div class=\"row text-center\">\n                            <div class=\"col-6\">\n                                <h4 class=\"text-info\" id=\"totalCards\">0</h4>\n                                <p class=\"text-muted\">Total Cards</p>\n                            </div>\n                            <div class=\"col-6\">\n                                <h4 class=\"text-warning\" id=\"totalResults\">0</h4>\n                                <p class=\"text-muted\">Total Results</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- Processing Log -->\n            <div class=\"col-md-4 mb-4\">\n                <div class=\"card\">\n                    <div class=\"card-header bg-dark text-white\">\n                        <i class=\"fas fa-terminal\"></i> Processing Log\n                        <button class=\"btn btn-sm btn-outline-light float-end\" onclick=\"clearLog()\">\n                            <i class=\"fas fa-trash\"></i>\n                        </button>\n                    </div>\n                    <div class=\"card-body p-0\">\n                        <div class=\"processing-log\" id=\"processingLog\">\n                            <div class=\"text-muted\">Ready for processing... Click any action button to start.</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js\"></script>\n    <script>\n        // Initialize with today's date\n        const today = new Date().toISOString().split('T')[0];\n        document.getElementById('startDate').value = today;\n        document.getElementById('endDate').value = today;\n        \n        function addLogEntry(message, type = 'info') {\n            const log = document.getElementById('processingLog');\n            const timestamp = new Date().toLocaleTimeString();\n            const entry = document.createElement('div');\n            \n            let className = '';\n            switch(type) {\n                case 'success': className = 'text-success'; break;\n                case 'error': className = 'text-danger'; break;\n                case 'warning': className = 'text-warning'; break;\n                default: className = 'text-info';\n            }\n            \n            entry.innerHTML = `<small class=\"text-muted\">[${timestamp}]</small> <span class=\"${className}\">${message}</span>`;\n            entry.style.marginBottom = '5px';\n            log.appendChild(entry);\n            log.scrollTop = log.scrollHeight;\n        }\n        \n        function clearLog() {\n            document.getElementById('processingLog').innerHTML = '<div class=\"text-muted\">Log cleared. Ready for processing...</div>';\n        }\n        \n        function processData(type, period) {\n            const today = new Date().toISOString().split('T')[0];\n            let startDate = today;\n            let endDate = today;\n            \n            if (period === 'week') {\n                const weekAgo = new Date();\n                weekAgo.setDate(weekAgo.getDate() - 7);\n                startDate = weekAgo.toISOString().split('T')[0];\n            }\n            \n            addLogEntry(`Starting ${type} processing for ${period}...`, 'info');\n            \n            fetch('/trigger-processing', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify({ type, startDate, endDate })\n            })\n            .then(response => response.json())\n            .then(data => {\n                if (data.status === 'success') {\n                    addLogEntry(`✅ ${type} processing started successfully`, 'success');\n                    updateStats();\n                } else {\n                    addLogEntry(`❌ Failed to start processing: ${data.message}`, 'error');\n                }\n            })\n            .catch(error => {\n                addLogEntry(`❌ Error: ${error.message}`, 'error');\n            });\n        }\n        \n        function processCustomRange() {\n            const startDate = document.getElementById('startDate').value;\n            const endDate = document.getElementById('endDate').value;\n            const dataType = document.getElementById('dataType').value;\n            \n            if (!startDate || !endDate) {\n                addLogEntry('❌ Please select both start and end dates', 'error');\n                return;\n            }\n            \n            if (new Date(startDate) > new Date(endDate)) {\n                addLogEntry('❌ Start date cannot be after end date', 'error');\n                return;\n            }\n            \n            addLogEntry(`Starting custom range processing: ${startDate} to ${endDate} (${dataType})...`, 'info');\n            \n            fetch('/trigger-processing', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify({ type: dataType, startDate, endDate })\n            })\n            .then(response => response.json())\n            .then(data => {\n                if (data.status === 'success') {\n                    addLogEntry(`✅ Custom range processing started successfully`, 'success');\n                    updateStats();\n                } else {\n                    addLogEntry(`❌ Failed to start processing: ${data.message}`, 'error');\n                }\n            })\n            .catch(error => {\n                addLogEntry(`❌ Error: ${error.message}`, 'error');\n            });\n        }\n        \n        function runFullPipeline() {\n            addLogEntry('🚀 Starting full pipeline...', 'info');\n            \n            fetch('/trigger-pipeline', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' }\n            })\n            .then(response => response.json())\n            .then(data => {\n                if (data.status === 'success') {\n                    addLogEntry('✅ Full pipeline started successfully', 'success');\n                    updateSystemStatus();\n                } else {\n                    addLogEntry(`❌ Failed to start pipeline: ${data.message}`, 'error');\n                }\n            })\n            .catch(error => {\n                addLogEntry(`❌ Pipeline error: ${error.message}`, 'error');\n            });\n        }\n        \n        function startAPIs() {\n            addLogEntry('🌐 Starting APIs...', 'info');\n            \n            fetch('/start-apis', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' }\n            })\n            .then(response => response.json())\n            .then(data => {\n                if (data.status === 'success') {\n                    addLogEntry('✅ APIs start triggered', 'success');\n                    updateSystemStatus();\n                } else {\n                    addLogEntry(`❌ Failed to start APIs: ${data.message}`, 'error');\n                }\n            })\n            .catch(error => {\n                addLogEntry(`❌ API start error: ${error.message}`, 'error');\n            });\n        }\n        \n        function testSystem() {\n            addLogEntry('🔍 Testing system health...', 'info');\n            \n            fetch('/system-status')\n            .then(response => response.json())\n            .then(data => {\n                updateSystemStatus(data);\n                addLogEntry('✅ System health check completed', 'success');\n            })\n            .catch(error => {\n                addLogEntry(`❌ Health check failed: ${error.message}`, 'error');\n            });\n        }\n        \n        function updateSystemStatus(data) {\n            // Update status indicators based on data\n            const dbStatus = document.getElementById('databaseStatus');\n            const apiStatus = document.getElementById('apiStatus');\n            const pipelineStatus = document.getElementById('pipelineStatus');\n            \n            if (data && data.database) {\n                dbStatus.className = 'status-online';\n                dbStatus.innerHTML = '<i class=\"fas fa-database fa-2x\"></i><p class=\"mt-2\">Database<br><small>Online</small></p>';\n            }\n            \n            if (data && data.apis) {\n                apiStatus.className = 'status-online';\n                apiStatus.innerHTML = '<i class=\"fas fa-brain fa-2x\"></i><p class=\"mt-2\">APIs<br><small>Running</small></p>';\n            }\n            \n            document.getElementById('lastUpdate').textContent = `Last Update: ${new Date().toLocaleString()}`;\n        }\n        \n        function updateStats() {\n            // Update processing statistics\n            fetch('/processing-stats')\n            .then(response => response.json())\n            .then(data => {\n                document.getElementById('cardsCount').textContent = data.cardsToday || 0;\n                document.getElementById('resultsCount').textContent = data.resultsToday || 0;\n                document.getElementById('totalCards').textContent = data.totalCards || 0;\n                document.getElementById('totalResults').textContent = data.totalResults || 0;\n            })\n            .catch(error => {\n                console.error('Failed to update stats:', error);\n            });\n        }\n        \n        // Auto-refresh every 30 seconds\n        setInterval(() => {\n            updateStats();\n            testSystem();\n        }, 30000);\n        \n        // Initial load\n        updateStats();\n        testSystem();\n    </script>\n</body>\n</html>",
    "output": "str",
    "x": 400,
    "y": 100,
    "wires": [["dashboard_response"]]
