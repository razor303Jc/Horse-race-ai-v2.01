        ]
    },
    {
        "id": "file_watcher_exec",
        "type": "exec",
        "z": "v205_integration_tab",
        "command": "python3",
        "addpay": false,
        "append": "/workspace/tools/file_monitoring/enhanced_file_watcher_v2_05.py --monitor --daemon",
        "useSpawn": "true",
        "timer": "",
        "winHide": false,
        "oldrc": false,
        "name": "Execute File Watcher",
        "x": 400,
        "y": 80,
        "wires": [
            ["watcher_output_parser"],
            ["watcher_error_handler"],
            []
        ]
    },
    {
        "id": "watcher_output_parser",
        "type": "function",
        "z": "v205_integration_tab",
        "name": "Parse Watcher Output",
        "func": "// Parse file watcher output and trigger processing\nif (msg.payload.includes('NEW_FILE_DETECTED')) {\n    try {\n        // Extract file path from watcher output\n        var lines = msg.payload.split('\\n');\n        var filePath = null;\n        \n        for (var i = 0; i < lines.length; i++) {\n            if (lines[i].includes('NEW_FILE_DETECTED:')) {\n                filePath = lines[i].split('NEW_FILE_DETECTED:')[1].trim();\n                break;\n            }\n        }\n        \n        if (filePath) {\n            msg.payload = {\n                action: 'process_file',\n                file_path: filePath,\n                detected_at: new Date().toISOString(),\n                processor_version: 'v2.05'\n            };\n            \n            node.status({fill: \"green\", shape: \"dot\", text: \"File detected: \" + filePath.split('/').pop()});\n            return msg;\n        }\n    } catch (e) {\n        node.error('Error parsing watcher output: ' + e.message);\n    }\n}\n\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 80,
        "wires": [
            ["file_processor_trigger"]
        ]
    },
    {
        "id": "file_processor_trigger",
        "type": "function",
        "z": "v205_integration_tab",
        "name": "Trigger Data Processor",
        "func": "// Prepare command for enhanced data processor v2.05\nif (msg.payload && msg.payload.action === 'process_file') {\n    var filePath = msg.payload.file_path;\n    var command = '/workspace/tools/data_processing/manage_data_processor_v2_05.sh process \"' + filePath + '\" --upload';\n    \n    msg.payload = {\n        command: command,\n        original_file: filePath,\n        timestamp: new Date().toISOString()\n    };\n    \n    node.status({fill: \"blue\", shape: \"ring\", text: \"Processing: \" + filePath.split('/').pop()});\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 80,
        "wires": [
            ["data_processor_exec"]
        ]
    },
    {
        "id": "data_processor_exec",
        "type": "exec",
        "z": "v205_integration_tab",
        "command": "",
        "addpay": "payload.command",
        "append": "",
        "useSpawn": "false",
        "timer": "60",
        "winHide": false,
        "oldrc": false,
        "name": "Execute Data Processor v2.05",
        "x": 1120,
        "y": 80,
        "wires": [
            ["processor_success_handler"],
            ["processor_error_handler"],
            []
        ]
    },
    {
        "id": "processor_success_handler",
        "type": "function",
        "z": "v205_integration_tab",
        "name": "Process Success",
        "func": "// Handle successful processing\nvar output = msg.payload;\nvar originalFile = msg.payload.original_file || 'unknown';\n\n// Parse processing results\nvar nullFixes = 0;\nvar recordsProcessed = 0;\n\nif (output.includes('NULL value fixes')) {\n    var match = output.match(/(\\d+) NULL value fixes/);\n    if (match) {\n        nullFixes = parseInt(match[1]);\n    }\n}\n\nif (output.includes('rows')) {\n    var matches = output.match(/(\\d+) → (\\d+) rows/g);\n    if (matches) {\n        recordsProcessed = matches.length;\n    }\n}\n\n// Update Redis status\nmsg.topic = 'processing_status';\nmsg.payload = {\n    status: 'success',\n    file: originalFile.split('/').pop(),\n    timestamp: new Date().toISOString(),\n    null_fixes: nullFixes,\n    tables_processed: recordsProcessed,\n    version: 'v2.05'\n};\n\nnode.status({fill: \"green\", shape: \"dot\", text: \"Success: \" + nullFixes + \" fixes\"});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 180,
        "wires": [
            ["redis_status_update", "processing_dashboard"]
        ]
    },
    {
        "id": "processor_error_handler",
        "type": "function",
        "z": "v205_integration_tab",
        "name": "Process Error",
        "func": "// Handle processing errors\nvar error = msg.payload;\nvar originalFile = msg.payload.original_file || 'unknown';\n\nmsg.topic = 'processing_error';\nmsg.payload = {\n    status: 'error',\n    file: originalFile.split('/').pop(),\n    error: error,\n    timestamp: new Date().toISOString(),\n    version: 'v2.05'\n};\n\nnode.status({fill: \"red\", shape: \"dot\", text: \"Error processing file\"});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 240,
        "wires": [
            ["redis_error_update", "error_notification"]
        ]
    },
    {
        "id": "watcher_error_handler",
        "type": "function",
        "z": "v205_integration_tab",
        "name": "Watcher Error",
        "func": "// Handle file watcher errors\nvar error = msg.payload;\n\nmsg.topic = 'watcher_error';\nmsg.payload = {\n    status: 'watcher_error',\n    error: error,\n    timestamp: new Date().toISOString(),\n    version: 'v2.05'\n};\n\nnode.status({fill: \"red\", shape: \"dot\", text: \"Watcher error\"});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 140,
        "wires": [
            ["redis_error_update"]
        ]
    },
