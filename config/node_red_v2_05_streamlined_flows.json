        "x": 170,
        "y": 100,
        "wires": [["redis_status_reader"]]
    },
    {
        "id": "redis_status_reader",
        "type": "redis in",
        "z": "main_dashboard_tab",
        "server": "redis_config",
        "command": "get",
        "name": "Get System Status",
        "topic": "system:status:v2_05",
        "x": 380,
        "y": 100,
        "wires": [["status_formatter"]]
    },
    {
        "id": "status_formatter",
        "type": "function",
        "z": "main_dashboard_tab",
        "name": "Format Status Data",
        "func": "try {\n    let status = {};\n    \n    if (msg.payload && typeof msg.payload === 'string') {\n        status = JSON.parse(msg.payload);\n    } else if (msg.payload && typeof msg.payload === 'object') {\n        status = msg.payload;\n    }\n    \n    // Format the status data for the dashboard\n    msg.timestamp = new Date().toLocaleString();\n    msg.watcher_status = status.file_watcher?.status || 'unknown';\n    msg.processor_status = status.data_processor?.status || 'unknown';\n    msg.redis_status = status.redis?.status || 'unknown';\n    msg.db_status = status.database?.status || 'unknown';\n    \n    msg.files_watched = status.file_watcher?.files_watched || 0;\n    msg.files_processed = status.data_processor?.files_processed || 0;\n    msg.null_fixes = status.data_processor?.null_fixes_applied || 0;\n    msg.redis_keys = status.redis?.keys_count || 0;\n    msg.redis_memory = status.redis?.memory_usage || 'N/A';\n    msg.total_records = status.database?.total_records || 0;\n    msg.last_check = status.file_watcher?.last_check || 'N/A';\n    msg.last_upload = status.database?.last_upload || 'N/A';\n    \n    return msg;\n} catch (error) {\n    // If there's an error parsing, return default status\n    msg.timestamp = new Date().toLocaleString();\n    msg.watcher_status = 'unknown';\n    msg.processor_status = 'unknown';\n    msg.redis_status = 'unknown';\n    msg.db_status = 'unknown';\n    msg.files_watched = 0;\n    msg.files_processed = 0;\n    msg.null_fixes = 0;\n    msg.redis_keys = 0;\n    msg.redis_memory = 'N/A';\n    msg.total_records = 0;\n    msg.last_check = 'N/A';\n    msg.last_upload = 'N/A';\n    \n    return msg;\n}",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 60,
        "wires": [["system_status_template"]]
    },
    {
        "id": "operation_router",
        "type": "switch",
        "z": "main_dashboard_tab",
        "name": "Route Operations",
        "property": "operation",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "file_watcher",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "data_processor",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "status_check",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "log_viewer",
                "vt": "str"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 4,
        "x": 780,
        "y": 200,
        "wires": [
            ["file_watcher_executor"],
            ["data_processor_executor"],
            ["status_check_executor"],
            ["log_viewer_executor"]
        ]
    },
