        "z": "main_dashboard_tab",
        "name": "Operation Debug",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 1280,
        "y": 280,
        "wires": []
    },
    {
        "id": "system_status_updater",
        "type": "function",
        "z": "main_dashboard_tab",
        "name": "Update System Status in Redis",
        "func": "// Create system status object\nconst systemStatus = {\n    timestamp: new Date().toISOString(),\n    file_watcher: {\n        status: 'ready',\n        version: 'v2.05',\n        files_watched: 0,\n        last_check: new Date().toLocaleString()\n    },\n    data_processor: {\n        status: 'ready',\n        version: 'v2.05',\n        files_processed: 0,\n        null_fixes_applied: 0\n    },\n    redis: {\n        status: 'connected',\n        keys_count: 0,\n        memory_usage: 'N/A'\n    },\n    database: {\n        status: 'connected',\n        total_records: 0,\n        last_upload: 'N/A'\n    }\n};\n\nmsg.payload = JSON.stringify(systemStatus);\nmsg.topic = 'system:status:v2_05';\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 300,
        "wires": [["redis_status_writer"]]
    },
    {
        "id": "redis_status_writer",
        "type": "redis out",
        "z": "main_dashboard_tab",
        "server": "redis_config",
        "command": "set",
        "name": "Store System Status",
        "topic": "",
        "x": 680,
        "y": 300,
        "wires": []
    },
    {
        "id": "initial_status_trigger",
        "type": "inject",
        "z": "main_dashboard_tab",
        "name": "Initialize Status on Start",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 1,
        "topic": "",
        "payload": "initialize",
        "payloadType": "str",
        "x": 180,
        "y": 300,
        "wires": [["system_status_updater"]]
    }
]
