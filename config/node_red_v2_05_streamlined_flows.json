        "addpay": false,
        "append": "",
        "useSpawn": "true",
        "timer": "",
        "winHide": false,
        "oldrc": false,
        "name": "Start File Watcher v2.05",
        "x": 1020,
        "y": 160,
        "wires": [
            ["operation_feedback"],
