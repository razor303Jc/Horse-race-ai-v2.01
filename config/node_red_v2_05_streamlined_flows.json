        "wires": [["redis_status_reader"]]
    },
    {
        "id": "log_viewer_executor",
        "type": "exec",
        "z": "main_dashboard_tab",
        "command": "tail -n 50 /data/logs/data_processor_v2_05.log",
        "addpay": false,
        "append": "",
        "useSpawn": "false",
        "timer": "",
        "winHide": false,
        "oldrc": false,
        "name": "Get Recent Logs",
        "x": 1020,
        "y": 280,
        "wires": [
            ["operation_feedback"],
            ["debug_output"],
            []
        ]
    },
    {
        "id": "operation_feedback",
        "type": "function",
        "z": "main_dashboard_tab",
        "name": "Format Operation Feedback",
        "func": "// Format operation feedback for the dashboard\nlet operation_message = \"\";\nlet operation_progress = 0;\n\nif (msg.payload) {\n    if (typeof msg.payload === 'string') {\n        operation_message = msg.payload.slice(0, 200) + (msg.payload.length > 200 ? '...' : '');\n    } else {\n        operation_message = JSON.stringify(msg.payload).slice(0, 200);\n    }\n    \n    // Set progress based on operation completion\n    if (operation_message.includes('completed') || operation_message.includes('success')) {\n        operation_progress = 100;\n    } else if (operation_message.includes('processing') || operation_message.includes('running')) {\n        operation_progress = 50;\n    } else {\n        operation_progress = 25;\n    }\n}\n\nmsg.operation_message = operation_message;\nmsg.operation_progress = operation_progress;\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1280,
        "y": 220,
        "wires": [["file_operations_template"]]
    },
    {
        "id": "debug_output",
