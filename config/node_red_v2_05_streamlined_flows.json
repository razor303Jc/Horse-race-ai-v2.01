        ]
    },
    {
        "id": "data_processor_executor",
        "type": "exec",
        "z": "main_dashboard_tab",
        "command": "python3 /data/tools/data_processing/enhanced_data_processor_v2_05.py /data/workspace_data/2025-08-20/results_2025-08-20_11-51-40_uk-results-jutrjw.zip --expected-date 2025-08-19 --report-only",
        "addpay": false,
        "append": "",
        "useSpawn": "false",
        "timer": "",
        "winHide": false,
        "oldrc": false,
        "name": "Run Data Processor v2.05",
        "x": 1020,
        "y": 200,
