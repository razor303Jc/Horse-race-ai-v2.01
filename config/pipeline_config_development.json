{
  "environment": "development",
  "debug_mode": true,
  "log_level": "DEBUG",
  "schedule": {
    "download_time": "00:01",
    "relationships_time": "00:30",
    "contextual_time": "01:00",
    "form_scoring_time": "01:30",
    "power_ratings_time": "02:00",
    "speed_analysis_time": "02:30",
    "monte_carlo_time": "03:00",
    "ml_training_time": "03:30",
    "race_trends_time": "04:00",
    "composite_scoring_time": "04:30",
    "betting_strategies_time": "05:00",
    "reporting_time": "05:30",
    "prerace_updates_time": "12:00",
    "live_prep_time": "13:00",
    "results_analysis_time": "20:00",
    "optimization_time": "19:00",
    "next_day_prep_time": "21:00"
  },
  "data_sources": {
    "enabled": [
      "racing_post",
      "betfair",
      "timeform"
    ],
    "retry_attempts": 3,
    "timeout_minutes": 30,
    "circuit_breaker_threshold": 5,
    "circuit_breaker_timeout": 300
  },
  "processing": {
    "batch_size": 1000,
    "parallel_workers": 4,
    "validation_threshold": 0.95,
    "memory_limit_mb": 4096,
    "max_processing_time_minutes": 60
  },
  "ml_models": {
    "retrain_threshold": 100,
    "model_types": [
      "random_forest",
      "gradient_boosting",
      "neural_network"
    ],
    "validation_split": 0.2,
    "max_training_time_minutes": 120,
    "feature_selection_threshold": 0.01
  },
  "database": {
    "host": "localhost",
    "port": 5433,
    "database": "horse_racing_db",
    "user": "horse_racing",
    "password": null,
    "pool_min_connections": 1,
    "pool_max_connections": 20,
    "connection_timeout": 30,
    "query_timeout": 300
  },
  "notifications": {
    "email_enabled": false,
    "slack_enabled": false,
    "discord_enabled": false,
    "webhook_url": null,
    "notification_level": "error",
    "max_notifications_per_hour": 10
  },
  "security": {
    "encrypt_sensitive_data": true,
    "audit_logging": true,
    "api_rate_limit": 100,
    "session_timeout_minutes": 60,
    "max_login_attempts": 5
  }
}