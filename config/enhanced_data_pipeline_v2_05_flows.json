        "name": "Process Error",
        "func": "// Handle processor error\nconst error = msg.payload;\nmsg.payload = {\n    status: \"error\",\n    error: error,\n    failed_at: new Date().toISOString(),\n    version: \"v2.05\"\n};\nmsg.topic = \"processing_failed\";\nreturn msg;",
        "outputs": 1,
