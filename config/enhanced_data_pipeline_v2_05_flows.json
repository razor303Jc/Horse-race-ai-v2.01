    {
        "id": "processor_success",
        "type": "function",
        "z": "v2_05_integration_tab",
        "name": "Process Success",
        "func": "// Parse processor output\nconst output = msg.payload;\nmsg.payload = {\n    status: \"success\",\n    output: output,\n    processed_at: new Date().toISOString(),\n    version: \"v2.05\"\n};\nmsg.topic = \"processing_complete\";\nreturn msg;",
