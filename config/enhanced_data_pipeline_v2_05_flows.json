        "command": "cd /workspace && python3 tools/data_processing/enhanced_data_processor_v2_05.py",
        "addpay": "true",
        "append": "--upload --expected-date",
        "useSpawn": "false",
        "timer": "",
        "oldrc": false,
        "name": "⚙️ Execute Data Processor",
        "x": 1520,
        "y": 240,
