            [
                "redis_get_watcher_status"
            ]
        ]
    },
    {
        "id": "redis_get_watcher_status",
        "type": "redis-in",
        "z": "v2_05_integration_tab", 
        "server": "redis_config_v2_05",
        "command": "get",
        "name": "Get Watcher Status",
        "topic": "",
        "x": 380,
        "y": 80,
        "wires": [
            [
                "parse_watcher_status"
            ]
        ]
    },
    {
        "id": "parse_watcher_status",
        "type": "function",
        "z": "v2_05_integration_tab",
        "name": "Parse Status",
        "func": "try {\n    if (msg.payload) {\n        const status = JSON.parse(msg.payload);\n        msg.payload = {\n            status: status.status,\n            last_check: status.last_check,\n            files_found: status.files_found || 0,\n            files_processed: status.files_processed || 0,\n            errors: status.errors || 0,\n            version: \"v2.05\"\n        };\n        msg.topic = \"watcher_status\";\n    } else {\n        msg.payload = {\n            status: \"not_running\",\n            message: \"File watcher not active\",\n            version: \"v2.05\"\n        };\n        msg.topic = \"watcher_error\";\n    }\n} catch(e) {\n    msg.payload = {\n        status: \"error\",\n        error: e.message,\n        version: \"v2.05\"\n    };\n    msg.topic = \"watcher_error\";\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 80,
        "wires": [
            [
                "watcher_status_display",
                "watcher_status_router"
            ]
        ]
    },
