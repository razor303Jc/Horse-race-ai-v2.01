    {
        "id": "parse_file_details",
        "type": "function",
        "z": "v2_05_integration_tab",
        "name": "Parse File Info",
        "func": "try {\n    const fileInfo = JSON.parse(msg.payload);\n    msg.payload = {\n        file_path: fileInfo.file_path,\n        expected_date: fileInfo.expected_date || fileInfo.detected_date,\n        size: fileInfo.size,\n        discovered_at: fileInfo.timestamp,\n        version: \"v2.05\"\n    };\n    msg.topic = \"file_ready\";\n    return msg;\n} catch(e) {\n    msg.payload = {\n        error: \"Failed to parse file info\",\n        details: e.message,\n        version: \"v2.05\"\n    };\n    msg.topic = \"file_error\";\n    return msg;\n}",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1270,
        "y": 240,
        "wires": [
            [
                "execute_data_processor"
            ]
        ]
