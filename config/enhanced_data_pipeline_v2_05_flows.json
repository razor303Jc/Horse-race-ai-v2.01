    {
        "id": "process_queue_items",
        "type": "function",
        "z": "v2_05_integration_tab",
        "name": "Process Queue",
        "func": "if (msg.payload && msg.payload.length > 0) {\n    // Found files in queue\n    msg.payload.forEach(key => {\n        // Create separate message for each file\n        const fileMsg = {\n            payload: key,\n            topic: \"process_file\"\n        };\n        node.send(fileMsg);\n    });\n    \n    // Send summary\n    msg.payload = {\n        queue_size: msg.payload.length,\n        action: \"processing_files\",\n        version: \"v2.05\"\n    };\n    msg.topic = \"queue_status\";\n    return msg;\n} else {\n    // No files in queue\n    msg.payload = {\n        queue_size: 0,\n        action: \"queue_empty\",\n        version: \"v2.05\"\n    };\n    msg.topic = \"queue_status\";\n    return msg;\n}",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 240,
        "wires": [
            [
                "queue_status_display",
                "trigger_data_processor"
            ]
        ]
    },
