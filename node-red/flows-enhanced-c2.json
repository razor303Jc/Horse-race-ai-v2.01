  {
    "id": "get_database_stats",
    "type": "function",
    "z": "system_monitor_tab",
    "name": "Get Database Stats",
    "func": "// Get real database statistics\nconst stats = {\n    timestamp: new Date().toISOString(),\n    cardsCount: 0,\n    resultsCount: 0,\n    filesProcessed: 0,\n    ntfyMessages: 0,\n    lastProcessing: 'Never',\n    systemHealth: 'healthy',\n    uptime: Math.floor(process.uptime()),\n    memoryUsage: Math.round(process.memoryUsage().heapUsed / 1024 / 1024) + ' MB'\n};\n\n// Real database stats will be implemented here\n// For demo purposes, using simulated values\nstats.cardsCount = Math.floor(Math.random() * 1000) + 500;\nstats.resultsCount = Math.floor(Math.random() * 800) + 300;\nstats.filesProcessed = Math.floor(Math.random() * 50) + 10;\nstats.ntfyMessages = Math.floor(Math.random() * 20) + 5;\nstats.lastProcessing = new Date(Date.now() - Math.random() * 3600000).toLocaleString();\n\nmsg.payload = stats;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
