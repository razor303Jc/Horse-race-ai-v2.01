  {
    "id": "c2_dashboard_template",
    "type": "template",
    "z": "c2_dashboard_tab",
    "name": "C2 Master Dashboard",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "mustache",
    "template": "<!DOCTYPE html>\n<html>\n<head>\n    <title>🎯 Horse Racing AI - Command & Control Center</title>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n    <style>\n        :root {\n            --primary-color: #1e3c72;\n            --secondary-color: #2a5298;\n            --success-color: #28a745;\n            --warning-color: #ffc107;\n            --danger-color: #dc3545;\n            --info-color: #17a2b8;\n        }\n        \n        body {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            min-height: 100vh;\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n        }\n        \n        .c2-container {\n            background: rgba(255, 255, 255, 0.95);\n            border-radius: 20px;\n            box-shadow: 0 20px 40px rgba(0,0,0,0.1);\n            backdrop-filter: blur(10px);\n            margin: 20px;\n            padding: 30px;\n        }\n        \n        .c2-header {\n            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));\n            color: white;\n            padding: 20px;\n            border-radius: 15px;\n            margin-bottom: 30px;\n            text-align: center;\n            box-shadow: 0 10px 20px rgba(0,0,0,0.1);\n        }\n        \n        .status-card {\n            border: none;\n            border-radius: 15px;\n            box-shadow: 0 10px 20px rgba(0,0,0,0.1);\n            transition: all 0.3s ease;\n            margin-bottom: 20px;\n            overflow: hidden;\n        }\n        \n        .status-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 15px 30px rgba(0,0,0,0.15);\n        }\n        \n        .card-header {\n            border: none;\n            font-weight: bold;\n            padding: 15px 20px;\n        }\n        \n        .metric-display {\n            text-align: center;\n            padding: 20px;\n        }\n        \n        .metric-value {\n            font-size: 2.5rem;\n            font-weight: bold;\n            margin-bottom: 5px;\n            display: block;\n        }\n        \n        .metric-label {\n            color: #6c757d;\n            font-size: 0.9rem;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n        }\n        \n        .status-indicator {\n            width: 15px;\n            height: 15px;\n            border-radius: 50%;\n            display: inline-block;\n            margin-right: 10px;\n            animation: pulse 2s infinite;\n        }\n        \n        .status-online { background: var(--success-color); }\n        .status-warning { background: var(--warning-color); }\n        .status-offline { background: var(--danger-color); }\n        \n        @keyframes pulse {\n            0% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); }\n            70% { box-shadow: 0 0 0 10px rgba(40, 167, 69, 0); }\n            100% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); }\n        }\n        \n        .control-button {\n            border: none;\n            border-radius: 10px;\n            padding: 12px 20px;\n            margin: 5px;\n            font-weight: bold;\n            transition: all 0.3s ease;\n            box-shadow: 0 5px 15px rgba(0,0,0,0.1);\n        }\n        \n        .control-button:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 8px 25px rgba(0,0,0,0.15);\n        }\n        \n        .notification-panel {\n            background: linear-gradient(135deg, #667eea, #764ba2);\n            color: white;\n            border-radius: 15px;\n            padding: 20px;\n            margin-bottom: 20px;\n        }\n        \n        .log-panel {\n            background: #1a1a1a;\n            color: #00ff00;\n            border-radius: 10px;\n            padding: 15px;\n            font-family: 'Courier New', monospace;\n            height: 300px;\n            overflow-y: auto;\n            font-size: 0.9rem;\n        }\n        \n        .real-time-badge {\n            position: absolute;\n            top: 10px;\n            right: 10px;\n            background: var(--success-color);\n            color: white;\n            padding: 5px 10px;\n            border-radius: 20px;\n            font-size: 0.8rem;\n            animation: blink 2s infinite;\n        }\n        \n        @keyframes blink {\n            0%, 50% { opacity: 1; }\n            51%, 100% { opacity: 0.5; }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"c2-container\">\n        <!-- C2 Header -->\n        <div class=\"c2-header\">\n            <h1><i class=\"fas fa-horse-head\"></i> Horse Racing AI - Command & Control Center</h1>\n            <p class=\"mb-0\">Real-time system orchestration with NTFY integration</p>\n            <div class=\"real-time-badge\">\n                <i class=\"fas fa-circle\"></i> LIVE\n            </div>\n        </div>\n        \n        <!-- System Overview Row -->\n        <div class=\"row\">\n            <!-- System Status -->\n            <div class=\"col-xl-3 col-md-6\">\n                <div class=\"card status-card\">\n                    <div class=\"card-header bg-primary text-white\">\n                        <i class=\"fas fa-heartbeat\"></i> System Health\n                    </div>\n                    <div class=\"card-body\">\n                        <div class=\"metric-display\">\n                            <div class=\"row\">\n                                <div class=\"col-6\">\n                                    <div id=\"webAppStatus\" class=\"mb-3\">\n                                        <span class=\"status-indicator status-online\"></span>\n                                        <small>Web App</small>\n                                    </div>\n                                    <div id=\"nodeRedStatus\">\n                                        <span class=\"status-indicator status-online\"></span>\n                                        <small>Node-RED</small>\n                                    </div>\n                                </div>\n                                <div class=\"col-6\">\n                                    <div id=\"ntfyStatus\" class=\"mb-3\">\n                                        <span class=\"status-indicator status-online\"></span>\n                                        <small>NTFY</small>\n                                    </div>\n                                    <div id=\"dbStatus\">\n                                        <span class=\"status-indicator status-warning\"></span>\n                                        <small>Database</small>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- Database Statistics -->\n            <div class=\"col-xl-3 col-md-6\">\n                <div class=\"card status-card\">\n                    <div class=\"card-header bg-success text-white\">\n                        <i class=\"fas fa-database\"></i> Database Stats\n                    </div>\n                    <div class=\"card-body\">\n                        <div class=\"metric-display\">\n                            <div class=\"metric-value text-primary\" id=\"cardsCount\">0</div>\n                            <div class=\"metric-label\">Race Cards</div>\n                            <hr>\n                            <div class=\"metric-value text-success\" id=\"resultsCount\">0</div>\n                            <div class=\"metric-label\">Results</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- Processing Pipeline -->\n            <div class=\"col-xl-3 col-md-6\">\n                <div class=\"card status-card\">\n                    <div class=\"card-header bg-info text-white\">\n                        <i class=\"fas fa-cogs\"></i> Processing\n                    </div>\n                    <div class=\"card-body\">\n                        <div class=\"metric-display\">\n                            <div class=\"metric-value text-info\" id=\"filesProcessed\">0</div>\n                            <div class=\"metric-label\">Files Today</div>\n                            <hr>\n                            <div id=\"lastProcessing\" class=\"text-muted small\">Never</div>\n                            <div class=\"metric-label\">Last Run</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- NTFY Notifications -->\n            <div class=\"col-xl-3 col-md-6\">\n                <div class=\"card status-card\">\n                    <div class=\"card-header bg-warning text-dark\">\n                        <i class=\"fas fa-bell\"></i> Notifications\n                    </div>\n                    <div class=\"card-body\">\n                        <div class=\"metric-display\">\n                            <div class=\"metric-value text-warning\" id=\"ntfyMessages\">0</div>\n                            <div class=\"metric-label\">Messages Today</div>\n                            <hr>\n                            <div class=\"metric-value text-secondary\">5</div>\n                            <div class=\"metric-label\">Active Topics</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Control Panels Row -->\n        <div class=\"row mt-4\">\n            <!-- Quick Actions -->\n            <div class=\"col-lg-6\">\n                <div class=\"card status-card\">\n                    <div class=\"card-header bg-dark text-white\">\n                        <i class=\"fas fa-rocket\"></i> Quick Actions\n                    </div>\n                    <div class=\"card-body\">\n                        <div class=\"row\">\n                            <div class=\"col-md-6 mb-3\">\n                                <button class=\"btn btn-primary control-button w-100\" onclick=\"triggerProcessing()\">\n                                    <i class=\"fas fa-play\"></i> Start Processing\n                                </button>\n                                <button class=\"btn btn-success control-button w-100\" onclick=\"runHealthCheck()\">\n                                    <i class=\"fas fa-stethoscope\"></i> Health Check\n                                </button>\n                                <button class=\"btn btn-info control-button w-100\" onclick=\"testNTFY()\">\n                                    <i class=\"fas fa-bell\"></i> Test NTFY\n                                </button>\n                            </div>\n                            <div class=\"col-md-6 mb-3\">\n                                <button class=\"btn btn-warning control-button w-100\" onclick=\"restartServices()\">\n                                    <i class=\"fas fa-redo\"></i> Restart Services\n                                </button>\n                                <button class=\"btn btn-secondary control-button w-100\" onclick=\"backupDatabase()\">\n                                    <i class=\"fas fa-save\"></i> Backup DB\n                                </button>\n                                <button class=\"btn btn-danger control-button w-100\" onclick=\"emergencyStop()\">\n                                    <i class=\"fas fa-stop\"></i> Emergency Stop\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- Real-time Log -->\n            <div class=\"col-lg-6\">\n                <div class=\"card status-card\">\n                    <div class=\"card-header bg-secondary text-white\">\n                        <i class=\"fas fa-terminal\"></i> System Log\n                        <button class=\"btn btn-sm btn-outline-light float-end\" onclick=\"clearLog()\">\n                            <i class=\"fas fa-trash\"></i> Clear\n                        </button>\n                    </div>\n                    <div class=\"card-body p-0\">\n                        <div class=\"log-panel\" id=\"systemLog\">\n                            <div>[SYSTEM] Command & Control Center initialized...</div>\n                            <div>[NTFY] Notification system ready</div>\n                            <div>[DB] Database connection established</div>\n                            <div>[INFO] System ready for operations</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- NTFY Integration Panel -->\n        <div class=\"row mt-4\">\n            <div class=\"col-12\">\n                <div class=\"notification-panel\">\n                    <h5><i class=\"fas fa-satellite-dish\"></i> NTFY Integration Status</h5>\n                    <div class=\"row\">\n                        <div class=\"col-md-3\">\n                            <strong>System Topic:</strong> horserace-system<br>\n                            <small class=\"text-light\">Status: Active</small>\n                        </div>\n                        <div class=\"col-md-3\">\n                            <strong>Processing Topic:</strong> horserace-processing<br>\n                            <small class=\"text-light\">Status: Active</small>\n                        </div>\n                        <div class=\"col-md-3\">\n                            <strong>Alerts Topic:</strong> horserace-alerts<br>\n                            <small class=\"text-light\">Status: Active</small>\n                        </div>\n                        <div class=\"col-md-3\">\n                            <strong>Monitor Topic:</strong> horserace-monitoring<br>\n                            <small class=\"text-light\">Status: Active</small>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Quick Links -->\n        <div class=\"row mt-4\">\n            <div class=\"col-12\">\n                <div class=\"card status-card\">\n                    <div class=\"card-header bg-gradient text-white\" style=\"background: linear-gradient(135deg, #667eea, #764ba2);\">\n                        <i class=\"fas fa-external-link-alt\"></i> System Access Points\n                    </div>\n                    <div class=\"card-body\">\n                        <div class=\"row text-center\">\n                            <div class=\"col-md-3\">\n                                <a href=\"http://localhost:3000\" target=\"_blank\" class=\"btn btn-outline-primary control-button w-100\">\n                                    <i class=\"fas fa-globe\"></i> Web App (3000)\n                                </a>\n                            </div>\n                            <div class=\"col-md-3\">\n                                <a href=\"http://localhost:1881\" target=\"_blank\" class=\"btn btn-outline-success control-button w-100\">\n                                    <i class=\"fas fa-project-diagram\"></i> Node-RED (1881)\n                                </a>\n                            </div>\n                            <div class=\"col-md-3\">\n                                <a href=\"http://localhost:8082\" target=\"_blank\" class=\"btn btn-outline-warning control-button w-100\">\n                                    <i class=\"fas fa-bell\"></i> NTFY (8082)\n                                </a>\n                            </div>\n                            <div class=\"col-md-3\">\n                                <a href=\"http://localhost:8080\" target=\"_blank\" class=\"btn btn-outline-info control-button w-100\">\n                                    <i class=\"fas fa-database\"></i> pgAdmin (8080)\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js\"></script>\n    <script>\n        let logCounter = 0;\n        \n        function addLogEntry(message, type = 'INFO') {\n            const log = document.getElementById('systemLog');\n            const timestamp = new Date().toLocaleTimeString();\n            const entry = document.createElement('div');\n            \n            let color = '#00ff00';\n            switch(type) {\n                case 'SUCCESS': color = '#00ff00'; break;\n                case 'ERROR': color = '#ff0000'; break;\n                case 'WARNING': color = '#ffff00'; break;\n                case 'NTFY': color = '#00ffff'; break;\n                default: color = '#ffffff';\n            }\n            \n            entry.innerHTML = `<span style=\"color: ${color}\">[${timestamp}] [${type}] ${message}</span>`;\n            log.appendChild(entry);\n            log.scrollTop = log.scrollHeight;\n            \n            // Keep only last 50 entries\n            if (log.children.length > 50) {\n                log.removeChild(log.firstChild);\n            }\n        }\n        \n        function clearLog() {\n            document.getElementById('systemLog').innerHTML = '<div>[SYSTEM] Log cleared - ready for operations</div>';\n        }\n        \n        function triggerProcessing() {\n            addLogEntry('Processing pipeline triggered...', 'INFO');\n            \n            fetch('/trigger-processing', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify({ action: 'process_today' })\n            })\n            .then(response => response.json())\n            .then(data => {\n                addLogEntry('Processing started successfully', 'SUCCESS');\n                updateStats();\n                sendNTFYNotification('Processing Started', 'Data processing pipeline initiated from C2 dashboard');\n            })\n            .catch(error => {\n                addLogEntry(`Processing failed: ${error.message}`, 'ERROR');\n                sendNTFYNotification('Processing Error', `Failed to start processing: ${error.message}`);\n            });\n        }\n        \n        function runHealthCheck() {\n            addLogEntry('Running comprehensive health check...', 'INFO');\n            \n            fetch('/health-check')\n            .then(response => response.json())\n            .then(data => {\n                updateSystemStatus(data);\n                addLogEntry('Health check completed - all systems operational', 'SUCCESS');\n                sendNTFYNotification('Health Check', 'System health check completed successfully');\n            })\n            .catch(error => {\n                addLogEntry(`Health check failed: ${error.message}`, 'ERROR');\n                sendNTFYNotification('Health Check Failed', `System health check error: ${error.message}`);\n            });\n        }\n        \n        function testNTFY() {\n            addLogEntry('Testing NTFY notification system...', 'NTFY');\n            sendNTFYNotification('C2 Test Notification', 'This is a test notification from the Command & Control dashboard!');\n        }\n        \n        function restartServices() {\n            if (confirm('Are you sure you want to restart all services? This may cause temporary downtime.')) {\n                addLogEntry('Restarting services...', 'WARNING');\n                sendNTFYNotification('Service Restart', 'System services restart initiated from C2 dashboard');\n                \n                fetch('/restart-services', {\n                    method: 'POST'\n                })\n                .then(response => response.json())\n                .then(data => {\n                    addLogEntry('Service restart completed', 'SUCCESS');\n                })\n                .catch(error => {\n                    addLogEntry(`Restart failed: ${error.message}`, 'ERROR');\n                });\n            }\n        }\n        \n        function backupDatabase() {\n            addLogEntry('Starting database backup...', 'INFO');\n            \n            fetch('/backup-database', {\n                method: 'POST'\n            })\n            .then(response => response.json())\n            .then(data => {\n                addLogEntry('Database backup completed successfully', 'SUCCESS');\n                sendNTFYNotification('Backup Complete', 'Database backup completed successfully');\n            })\n            .catch(error => {\n                addLogEntry(`Backup failed: ${error.message}`, 'ERROR');\n                sendNTFYNotification('Backup Failed', `Database backup error: ${error.message}`);\n            });\n        }\n        \n        function emergencyStop() {\n            if (confirm('EMERGENCY STOP: This will halt all automated processes. Are you sure?')) {\n                addLogEntry('EMERGENCY STOP ACTIVATED', 'ERROR');\n                sendNTFYNotification('EMERGENCY STOP', 'Emergency stop triggered from C2 dashboard - all processes halted!');\n                \n                fetch('/emergency-stop', {\n                    method: 'POST'\n                })\n                .then(response => response.json())\n                .then(data => {\n                    addLogEntry('All processes stopped', 'WARNING');\n                })\n                .catch(error => {\n                    addLogEntry(`Emergency stop error: ${error.message}`, 'ERROR');\n                });\n            }\n        }\n        \n        function sendNTFYNotification(title, message) {\n            fetch('/send-ntfy', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify({ title, message, topic: 'horserace-system' })\n            })\n            .then(response => response.json())\n            .then(data => {\n                addLogEntry(`NTFY sent: ${title}`, 'NTFY');\n            })\n            .catch(error => {\n                addLogEntry(`NTFY failed: ${error.message}`, 'ERROR');\n            });\n        }\n        \n        function updateStats() {\n            fetch('/system-stats')\n            .then(response => response.json())\n            .then(data => {\n                document.getElementById('cardsCount').textContent = data.cardsCount || 0;\n                document.getElementById('resultsCount').textContent = data.resultsCount || 0;\n                document.getElementById('filesProcessed').textContent = data.filesProcessed || 0;\n                document.getElementById('ntfyMessages').textContent = data.ntfyMessages || 0;\n                document.getElementById('lastProcessing').textContent = data.lastProcessing || 'Never';\n            })\n            .catch(error => {\n                addLogEntry(`Stats update failed: ${error.message}`, 'ERROR');\n            });\n        }\n        \n        function updateSystemStatus(data) {\n            // Update status indicators based on real data\n            // Implementation would update the status indicators\n            addLogEntry('System status updated', 'INFO');\n        }\n        \n        // Auto-refresh every 30 seconds\n        setInterval(() => {\n            updateStats();\n            addLogEntry('Auto-refresh: Stats updated', 'INFO');\n        }, 30000);\n        \n        // Initial load\n        updateStats();\n        addLogEntry('C2 Dashboard fully loaded and operational', 'SUCCESS');\n    </script>\n</body>\n</html>",
    "output": "str",
    "x": 400,
    "y": 100,
    "wires": [["c2_dashboard_response"]]
  },

