  {
    "id": "process_data_handler",
    "type": "function",
    "z": "data_pipeline_tab",
    "name": "Process Data Handler",
    "func": "// Handle data processing requests\nconst action = msg.payload.action || 'process_today';\nconst today = new Date().toISOString().split('T')[0];\n\nlet command = '';\nswitch(action) {\n    case 'process_today':\n        command = `cd /home/jc/Documents/Horse-race-ai-v2.04 && python3 scripts/main_data_processor.py --date ${today}`;\n        break;\n    case 'process_cards':\n        command = `cd /home/jc/Documents/Horse-race-ai-v2.04 && python3 scripts/card_processor.py --date ${today}`;\n        break;\n    case 'process_results':\n        command = `cd /home/jc/Documents/Horse-race-ai-v2.04 && python3 scripts/results_processor.py --date ${today}`;\n        break;\n    default:\n        command = `cd /home/jc/Documents/Horse-race-ai-v2.04 && python3 scripts/main_data_processor.py`;\n}\n\nmsg.payload = { command: command, action: action };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 100,
    "wires": [["execute_processing"]]
  },

