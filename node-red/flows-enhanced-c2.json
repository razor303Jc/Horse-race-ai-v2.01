  {
    "id": "ntfy_prepare",
    "type": "function",
    "z": "notifications_tab",
    "name": "Prepare NTFY Request",
    "func": "// Prepare NTFY notification request\nconst title = msg.payload.title || 'System Notification';\nconst message = msg.payload.message || 'No message provided';\nconst topic = msg.payload.topic || 'horserace-system';\nconst tags = msg.payload.tags || 'system';\nconst priority = msg.payload.priority || 'default';\n\n// Set the URL for NTFY\nmsg.url = `http://localhost:8082/${topic}`;\n\n// Set headers\nmsg.headers = {\n    'Content-Type': 'text/plain',\n    'Title': title,\n    'Tags': tags,\n    'Priority': priority\n};\n\n// Set the message as payload\nmsg.payload = message;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 100,
    "wires": [["send_ntfy_notification"]]
  },

