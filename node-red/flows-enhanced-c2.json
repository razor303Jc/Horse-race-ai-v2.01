  {
    "id": "processing_success",
    "type": "function",
    "z": "data_pipeline_tab",
    "name": "Processing Success",
    "func": "// Handle successful processing\nconst timestamp = new Date().toISOString();\n\n// Send success response\nlet response = {\n    payload: {\n        status: 'success',\n        message: 'Processing completed successfully',\n        timestamp: timestamp,\n        output: msg.payload\n    }\n};\n\n// Send NTFY notification\nlet ntfyMsg = {\n    payload: {\n        title: '✅ Processing Complete',\n        message: `Data processing completed successfully at ${new Date().toLocaleString()}`,\n        topic: 'horserace-processing',\n        tags: 'success,processing,complete',\n        priority: 'default'\n    }\n};\n\nreturn [response, ntfyMsg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 820,
    "y": 80,
    "wires": [["processing_response"], ["send_ntfy_notification"]]
  },

  {
    "id": "processing_error",
    "type": "function",
    "z": "data_pipeline_tab",
    "name": "Processing Error",
    "func": "// Handle processing errors\nconst timestamp = new Date().toISOString();\nconst error = msg.payload || 'Unknown error';\n\n// Send error response\nlet response = {\n    payload: {\n        status: 'error',\n        message: `Processing failed: ${error}`,\n        timestamp: timestamp,\n        error: error\n    }\n};\n\n// Send NTFY alert\nlet ntfyMsg = {\n    payload: {\n        title: '❌ Processing Failed',\n        message: `Data processing failed: ${error}`,\n        topic: 'horserace-alerts',\n        tags: 'error,processing,failed',\n        priority: 'high'\n    }\n};\n\nreturn [response, ntfyMsg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
