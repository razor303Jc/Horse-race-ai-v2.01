  {
    "id": "health_ntfy_notification",
    "type": "function",
    "z": "system_monitor_tab",
    "name": "Health NTFY",
    "func": "// Send health check notification\nconst health = msg.payload;\nconst status = health.overall_status;\n\nlet title, priority, tags;\nswitch(status) {\n    case 'healthy':\n        title = '✅ System Health: All Systems Operational';\n        priority = 'default';\n        tags = 'health,success,system';\n        break;\n    case 'degraded':\n        title = '⚠️ System Health: Some Issues Detected';\n        priority = 'default';\n        tags = 'health,warning,system';\n        break;\n    case 'critical':\n        title = '🚨 System Health: Critical Issues';\n        priority = 'high';\n        tags = 'health,critical,system';\n        break;\n    default:\n        title = '📊 System Health Check';\n        priority = 'default';\n        tags = 'health,system';\n}\n\nconst message = `Health check completed at ${new Date().toLocaleString()}. Status: ${status.toUpperCase()}. Services: ${Object.keys(health.services).length} monitored.`;\n\nmsg.payload = {\n    title: title,\n    message: message,\n    topic: 'horserace-monitoring',\n    tags: tags,\n    priority: priority\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,\n    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 660,
    "y": 140,
    "wires": [["ntfy_prepare"]]
  },

