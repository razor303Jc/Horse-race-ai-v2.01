  {
    "id": "system_health_check",
    "type": "function",
    "z": "system_monitor_tab",
    "name": "System Health Check",
    "func": "// Comprehensive system health check\nconst health = {\n    timestamp: new Date().toISOString(),\n    overall_status: 'healthy',\n    services: {\n        web_app: { \n            status: 'online', \n            port: 3000,\n            endpoint: 'http://localhost:3000'\n        },\n        node_red: { \n            status: 'online', \n            port: 1881,\n            endpoint: 'http://localhost:1881'\n        },\n        ntfy: { \n            status: 'online', \n            port: 8082,\n            endpoint: 'http://localhost:8082'\n        },\n        postgres: { \n            status: 'checking', \n            port: 5432,\n            databases: ['cards_horse_racing_db', 'results_horse_racing_db', 'advanced_racing_metrics_db']\n        }\n    },\n    metrics: {\n        uptime: process.uptime(),\n        memory_usage: process.memoryUsage(),\n        node_version: process.version,\n        platform: process.platform\n    },\n    database_stats: {\n        cards_count: 0,\n        results_count: 0,\n        last_update: null\n    },\n    notifications: {\n        ntfy_accessible: true,\n        topics_active: 5,\n        last_notification: null\n    }\n};\n\n// Check for any issues\nlet issues = 0;\nObject.values(health.services).forEach(service => {\n    if (service.status === 'offline') issues++;\n});\n\nif (issues > 0) {\n    health.overall_status = issues > 2 ? 'critical' : 'degraded';\n}\n\nmsg.payload = health;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 100,
    "wires": [["health_response", "health_ntfy_notification"]]
  },

