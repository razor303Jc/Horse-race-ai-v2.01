ch node will pass the message if the action is successful, otherwise it will throw an exception and drop the message.\n","maintainers":[{"name":"deancording","email":"dean@cording.id.au"}],"time":{"modified":"2022-06-21T19:14:02.887Z","created":"2016-07-07T06:43:36.634Z","1.0.0":"2016-07-07T06:43:36.634Z","1.0.1":"2016-07-08T02:49:42.122Z","1.0.2":"2016-07-11T13:16:26.444Z","1.1.0":"2016-07-11T14:34:25.749Z","1.1.1":"2016-07-13T06:01:46.711Z","1.1.2":"2016-07-13T06:05:46.587Z","1.1.3":"2016-07-14T07:51:31.378Z","1.1.4":"2016-07-14T08:05:30.645Z","1.1.5":"2016-07-15T08:07:39.856Z","1.2.0":"2016-07-24T07:37:49.825Z","1.2.1":"2016-07-30T12:04:00.525Z","1.2.2":"2016-09-12T12:26:43.660Z","1.2.3":"2017-03-29T11:32:01.136Z","1.3.0":"2018-04-13T08:33:55.110Z","1.4.0":"2018-04-13T14:34:09.403Z","1.5.0":"2018-12-05T05:46:24.395Z","1.6.0":"2020-08-31T11:50:35.595Z"},"homepage":"https://github.com/DeanCording/node-red-contrib-fs-ops","keywords":["node-red","fs","move","rename","delete","copy"],"repository":{"type":"git","url":"git+https://github.com/DeanCording/node-red-contrib-fs-ops.git"},"author":{"name":"Dean Cording","email":"dean@cording.id.au"},"bugs":{"url":"https://github.com/DeanCording/node-red-contrib-fs-ops/issues"},"license":"MIT","readmeFilename":"README.md"}