    "node-red-contrib-fs-ops": "^1.7.0",
    "node-red-contrib-moment": "^4.0.0",
    "node-red-contrib-cron-plus": "^1.6.1",
    "node-red-contrib-slack": "^1.1.0",
    "node-red-contrib-pushover": "^1.0.1",
    "node-red-contrib-telegrambot": "^14.12.0",
    "node-red-contrib-discord": "^1.1.0",
    "node-red-contrib-csv": "^1.0.3",
    "node-red-contrib-file-function": "^1.3.0",
    "node-red-contrib-credentials": "^1.0.0",
    "node-red-contrib-influxdb": "^0.6.1",
    "node-red-contrib-web-worldmap": "^2.36.0",
    "node-red-contrib-ui-table": "^0.4.3",
    "node-red-contrib-ui-led": "^0.4.11",
    "node-red-contrib-ui-level": "^0.1.6",
    "node-red-contrib-ui-media": "^2.3.1",
    "node-red-contrib-chartjs": "^1.0.9",
    "node-red-contrib-simple-gate": "^0.5.2",
    "node-red-contrib-flow-manager": "^0.6.0",
    "node-red-contrib-loop-processing": "^0.5.1",
    "node-red-contrib-counter": "^0.1.6",
    "node-red-contrib-string": "^1.0.0",
    "node-red-contrib-boolean-logic": "^0.0.3",
    "node-red-contrib-timeout": "^1.0.1"
  },
  "node-red": {
    "settings": {
      "flowFile": "flows.json",
      "credentialsFile": "flows_cred.json",
      "flowFilePretty": true,
      "adminAuth": {
        "type": "credentials",
        "users": [
          {
            "username": "admin",
            "password": "$2b$08$zZWtXTja0fB1pzD4sHCMyOCMYz2Z6dNbM6tl8sJogENOMcxWV9DN.",
            "permissions": "*"
          }
        ]
      },
      "httpNodeAuth": false,
      "httpRoot": "/",
      "httpAdminRoot": "/admin",
      "ui": {
        "path": "ui"
      },
      "logging": {
        "console": {
          "level": "info",
          "metrics": false,
          "audit": false
        },
        "file": {
          "level": "info",
          "filename": "/data/node-red.log",
          "maxFiles": 5,
          "maxFileSize": "10MB"
        }
      },
      "exportGlobalContextKeys": false,
      "contextStorage": {
        "default": "memoryOnly",
        "memoryOnly": {
          "module": "memory"
        },
        "file": {
          "module": "localfilesystem"
        }
      },
      "functionGlobalContext": {},
      "debugMaxLength": 1000,
      "mqttReconnectTime": 15000,
      "serialReconnectTime": 15000
    }
  }
}
