{
  "name": "horse-racing-ai-node-red",
  "description": "Node-RED automation for Horse Racing AI system",
  "version": "1.0.0",
  "dependencies": {
    "node-red-dashboard": "^3.6.0",
    "node-red-node-cron-plus": "^1.3.1",
    "node-red-node-email": "^1.18.4",
