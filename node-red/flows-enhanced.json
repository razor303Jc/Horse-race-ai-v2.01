  {
    "id": "daily_schedule",
    "type": "cronplus",
    "z": "tab_data_pipeline",
    "name": "Daily Data Collection",
    "outputField": "payload",
    "timeZone": "",
    "persistDynamic": false,
    "commandResponseMsgOutput": "output1",
    "outputs": 1,
    "options": [
      {
        "name": "schedule1",
        "topic": "daily_collection",
        "payloadType": "default",
        "payload": "",
        "expressionType": "cron",
        "expression": "0 6,22 * * *",
        "location": "",
        "offset": "0",
        "solarType": "all",
        "solarEvents": "sunrise,sunset"
      }
    ],
    "x": 180,
    "y": 100,
    "wires": [["data_download_trigger"]]
  },
  {
    "id": "data_download_trigger",
    "type": "function",
    "z": "tab_data_pipeline",
    "name": "Prepare Download",
    "func": "// Prepare data download parameters\nconst timestamp = new Date().toISOString();\nconst downloadPath = '/workspace/data';\n\nmsg.payload = {\n    timestamp: timestamp,\n    downloadPath: downloadPath,\n    source: 'scheduled',\n    action: 'download_racecards'\n};\n\n// Log the start\nnode.status({fill:\"blue\",shape:\"dot\",text:\"Starting download...\"});\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 100,
    "wires": [["download_executor"]]
  },
  {
    "id": "download_executor",
    "type": "exec",
    "z": "tab_data_pipeline",
    "command": "cd /workspace && python scripts/daily_downloader.py",
    "addpay": false,
    "append": "",
    "useSpawn": "false",
    "timer": "300",
    "winHide": false,
    "oldrc": false,
    "name": "Execute Download",
    "x": 580,
    "y": 100,
    "wires": [["download_success"], ["download_error"], ["download_error"]]
  },
  {
    "id": "download_success",
    "type": "function",
    "z": "tab_data_pipeline",
    "name": "Process Success",
    "func": "// Process successful download\nconst timestamp = new Date().toISOString();\n\nmsg.payload = {\n    status: 'success',\n    timestamp: timestamp,\n    message: 'Data download completed successfully',\n    nextStep: 'clean_csv'\n};\n\nnode.status({fill:\"green\",shape:\"dot\",text:\"Download complete\"});\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 780,
    "y": 80,
    "wires": [["csv_cleaner"]]
  },
  {
    "id": "download_error",
    "type": "function", 
    "z": "tab_data_pipeline",
    "name": "Handle Error",
    "func": "// Handle download error\nconst timestamp = new Date().toISOString();\n\nmsg.payload = {\n    status: 'error',\n    timestamp: timestamp,\n    error: msg.payload,\n    step: 'download',\n    severity: 'high'\n};\n\nnode.status({fill:\"red\",shape:\"dot\",text:\"Download failed\"});\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 780,
    "y": 120,
    "wires": [["error_alert"]]
  },
  {
    "id": "csv_cleaner",
    "type": "exec",
    "z": "tab_data_pipeline",
    "command": "cd /workspace && python tools/data_quality/csv_data_cleaner.py",
    "addpay": false,
    "append": "",
    "useSpawn": "false",
    "timer": "180",
    "winHide": false,
    "oldrc": false,
    "name": "Clean CSV Data",
    "x": 980,
    "y": 80,
    "wires": [["csv_success"], ["csv_error"], ["csv_error"]]
  },
  {
    "id": "csv_success",
    "type": "function",
    "z": "tab_data_pipeline",
    "name": "CSV Cleaned",
    "func": "// CSV cleaning successful\nconst timestamp = new Date().toISOString();\n\nmsg.payload = {\n    status: 'success',\n    timestamp: timestamp,\n    message: 'CSV data cleaned successfully',\n    nextStep: 'import_database'\n};\n\nnode.status({fill:\"green\",shape:\"dot\",text:\"CSV cleaned\"});\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1180,
    "y": 60,
    "wires": [["db_import"]]
  },
  {
    "id": "csv_error",
    "type": "function",
    "z": "tab_data_pipeline",
    "name": "CSV Error",
    "func": "// CSV cleaning error\nconst timestamp = new Date().toISOString();\n\nmsg.payload = {\n    status: 'error',\n    timestamp: timestamp,\n    error: msg.payload,\n    step: 'csv_cleaning',\n    severity: 'medium'\n};\n\nnode.status({fill:\"red\",shape:\"dot\",text:\"CSV cleaning failed\"});\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1180,
    "y": 100,
    "wires": [["error_alert"]]
  },
  {
    "id": "db_import",
    "type": "exec",
    "z": "tab_data_pipeline",
    "command": "cd /workspace && python tools/bulk_uploader/bulk_upload_processor.py",
    "addpay": false,
    "append": "",
    "useSpawn": "false",
    "timer": "300",
    "winHide": false,
    "oldrc": false,
    "name": "Import to Database",
    "x": 1380,
    "y": 60,
    "wires": [["import_success"], ["import_error"], ["import_error"]]
  },
  {
    "id": "import_success",
    "type": "function",
    "z": "tab_data_pipeline",
    "name": "Import Complete",
    "func": "// Database import successful\nconst timestamp = new Date().toISOString();\n\nmsg.payload = {\n    status: 'success',\n    timestamp: timestamp,\n    message: 'Database import completed successfully',\n    nextStep: 'generate_predictions'\n};\n\nnode.status({fill:\"green\",shape:\"dot\",text:\"Import complete\"});\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1580,
    "y": 40,
    "wires": [["success_notification", "update_dashboard"]]
  },
  {
    "id": "import_error",
    "type": "function",
    "z": "tab_data_pipeline",
    "name": "Import Error",
    "func": "// Database import error\nconst timestamp = new Date().toISOString();\n\nmsg.payload = {\n    status: 'error',\n    timestamp: timestamp,\n    error: msg.payload,\n    step: 'database_import',\n    severity: 'high'\n};\n\nnode.status({fill:\"red\",shape:\"dot\",text:\"Import failed\"});\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1580,
    "y": 80,
    "wires": [["error_alert"]]
  },
