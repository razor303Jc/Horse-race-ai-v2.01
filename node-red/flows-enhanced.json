  {
    "id": "update_dashboard",
    "type": "function",
    "z": "tab_dashboard",
    "name": "Update System Status",
    "func": "// Update dashboard with latest system status\nconst timestamp = new Date().toLocaleString();\n\n// System health (example calculation)\nconst health = 95; // Would be calculated based on system metrics\n\n// Send updates to dashboard components\nnode.send([\n    {payload: health, topic: \"system_health\"},\n    {payload: timestamp, topic: \"last_update\"},\n    {payload: 0, topic: \"error_count\"} // Would be actual error count\n]);\n\nreturn null;",
    "outputs": 3,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 140,
    "wires": [["system_status"], ["last_update"], ["error_count"]]
  },
