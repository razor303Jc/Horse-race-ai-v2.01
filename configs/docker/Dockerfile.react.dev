# Development Dockerfile with hot reloading
FROM node:18 as node-base

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Python requirements and install Python dependencies
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt
RUN pip3 install --no-cache-dir fastapi uvicorn python-multipart psycopg2-binary

# Copy package.json and install Node dependencies
COPY src/web/package*.json ./frontend/
WORKDIR /app/frontend
RUN npm install

# Install global development tools
RUN npm install -g grunt-cli browser-sync concurrently

# Copy source code (will be mounted as volume in development)
WORKDIR /app
COPY src/ ./src/
COPY pyproject.toml .

# Set up Python path
ENV PYTHONPATH=/app
ENV NODE_ENV=development

# Create necessary directories
RUN mkdir -p /app/data /app/logs /app/models /app/cache /app/reports

# Expose ports
EXPOSE 5003 8001 24678

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5003 && curl -f http://localhost:8001/api/system_status || exit 1

# Default development command
CMD ["sh", "-c", "cd /app/frontend && npm run dev -- --host 0.0.0.0 --port 5003 & cd /app && python src/web/api_server_enhanced.py & wait"]
