# Test-enabled Dockerfile for Horse Racing AI v2.0
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies for Playwright and testing
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    ca-certificates \
    curl \
    netcat-openbsd \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install additional testing dependencies
RUN pip install --no-cache-dir \
    pytest-html \
    pytest-xdist \
    pytest-timeout \
    pytest-env \
    coverage[toml]

# Install Playwright browsers
RUN playwright install --with-deps

# Copy project structure
COPY src/ ./src/
COPY tests/ ./tests/
COPY pyproject.toml .
COPY pytest.ini .
COPY .coverage .
COPY main.py .

# Copy configuration files
COPY .env.example ./.env
COPY docker/ ./docker/

# Install the package in development mode
RUN pip install -e .

# Create directories
RUN mkdir -p /app/data /app/logs /app/models /app/cache /app/test-results

# Create non-root user
RUN groupadd -r horseai && useradd -r -g horseai horseai
RUN chown -R horseai:horseai /app
USER horseai

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV TESTING=true

# Health check script
COPY --chown=horseai:horseai docker/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/healthcheck.sh

# Expose ports
EXPOSE 5002 8000

# Default command runs tests
CMD ["pytest", "tests/", "-v", "--cov=src", "--cov-report=html:/app/test-results/coverage", "--html=/app/test-results/report.html", "--self-contained-html"]
