# Pipeline Management Container
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    cron \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy pipeline management scripts
COPY docker/pipeline_management/ ./pipeline_management/
COPY tools/ ./tools/
COPY config/ ./config/
COPY src/ ./src/

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Create directories
RUN mkdir -p /app/logs /app/cache

# Create non-root user
RUN groupadd -r pipelinemanager && useradd -r -g pipelinemanager -m pipelinemanager
RUN chown -R pipelinemanager:pipelinemanager /app

USER pipelinemanager

# Default command
CMD ["python", "pipeline_management/dynamic_pipeline_timing.py"]
